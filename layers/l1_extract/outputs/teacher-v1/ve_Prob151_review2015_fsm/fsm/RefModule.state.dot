digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (two-process, 10 states)";
  __reset [shape=point, width=0.15];
  __reset -> "S" [label="reset"];
  "S" [peripheries=2, label="S"];
  "S1" [label="S1"];
  "S11" [label="S11"];
  "S110" [label="S110"];
  "B0" [label="B0"];
  "B1" [label="B1"];
  "B2" [label="B2"];
  "B3" [label="B3"];
  "Count" [label="Count"];
  "Wait" [label="Wait"];
  "S" -> "S1" [label="data"];
  "S1" -> "S11" [label="data"];
  "S1" -> "S" [label="!data"];
  "S11" -> "S110" [label="!data"];
  "S110" -> "B0" [label="data"];
  "S110" -> "S" [label="!data"];
  "B0" -> "B1" [label=""];
  "B1" -> "B2" [label=""];
  "B2" -> "B3" [label=""];
  "B3" -> "Count" [label=""];
  "Count" -> "Wait" [label="done_counting"];
  "Wait" -> "S" [label="ack"];
  __outs [shape=note, fontsize=9, label="outputs: counting(moore), done(moore), shift_ena(moore)"];
}