digraph "RefModule.mv" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.mv (one-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "TRK_W" [label="reset"];
  "TRK_W" [peripheries=2, label="TRK_W"];
  "DROP_W" [label="DROP_W"];
  "DROP_E" [label="DROP_E"];
  "TRK_E" [label="TRK_E"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "DROP_W" [label="gnd_lost && mv[1]", style=dashed, color="#e76f51"];
  "__any" -> "DROP_E" [label="gnd_lost && !mv[1] && mv[3]", style=dashed, color="#e76f51"];
  "__any" -> "TRK_E" [label="!gnd_lost && to_east", style=dashed, color="#e76f51"];
  "__any" -> "TRK_W" [label="!gnd_lost && !to_east", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: aaah(moore), walk_left(moore), walk_right(moore)"];
}