digraph "axis_cobs_encode.input_state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_cobs_encode.input_state_reg (two-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "INPUT_STATE_IDLE" [label="reset"];
  "INPUT_STATE_IDLE" [peripheries=2, label="INPUT_STATE_IDLE"];
  "INPUT_STATE_FINAL_ZERO" [label="INPUT_STATE_FINAL_ZERO"];
  "INPUT_STATE_APPEND_ZERO" [label="INPUT_STATE_APPEND_ZERO"];
  "INPUT_STATE_SEGMENT" [label="INPUT_STATE_SEGMENT"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "INPUT_STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "INPUT_STATE_IDLE" -> "INPUT_STATE_FINAL_ZERO" [label="s_axis_tready && s_axis_tvalid && (s_axis_tdata == 8'd0 || …"];
  "INPUT_STATE_IDLE" -> "INPUT_STATE_APPEND_ZERO" [label="s_axis_tready && s_axis_tvalid && !(s_axis_tdata == 8'd0 ||…"];
  "INPUT_STATE_IDLE" -> "INPUT_STATE_SEGMENT" [label="s_axis_tready && s_axis_tvalid && !(s_axis_tdata == 8'd0 ||…"];
  "INPUT_STATE_SEGMENT" -> "INPUT_STATE_FINAL_ZERO" [label="s_axis_tready && s_axis_tvalid && (s_axis_tdata == 8'd0 || …"];
  "INPUT_STATE_SEGMENT" -> "INPUT_STATE_IDLE" [label="s_axis_tready && s_axis_tvalid && (s_axis_tdata == 8'd0 || …"];
  "INPUT_STATE_SEGMENT" -> "INPUT_STATE_APPEND_ZERO" [label="s_axis_tready && s_axis_tvalid && !(s_axis_tdata == 8'd0 ||…"];
  "INPUT_STATE_FINAL_ZERO" -> "INPUT_STATE_APPEND_ZERO" [label="code_fifo_in_tready"];
  "INPUT_STATE_APPEND_ZERO" -> "INPUT_STATE_IDLE" [label="code_fifo_in_tready"];
  __outs [shape=note, fontsize=9, label="outputs: s_axis_tready_mask(moore)"];
}