digraph "RefModule.cur" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.cur (two-process, 10 states)";
  "R0" [label="R0"];
  "R1" [label="R1"];
  "R2" [label="R2"];
  "R3" [label="R3"];
  "R4" [label="R4"];
  "R5" [label="R5"];
  "R6" [label="R6"];
  "OVF" [label="OVF"];
  "DRP" [label="DRP"];
  "MRK" [label="MRK"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "R0" [label="", style=dashed, color="#e76f51"];
  "R6" -> "OVF" [label="!(cur == OVF) && in"];
  "R6" -> "MRK" [label="!(cur == OVF) && !in"];
  "__any" -> "DRP" [label="!(cur == OVF) && !(cur == R6) && cur == R5 && lo", style=dashed, color="#e76f51"];
  "R0" -> "R1" [label="!(cur == OVF) && !(cur == R6) && !(cur == R5 && lo) && !lo"];
  "R1" -> "R2" [label="!(cur == OVF) && !(cur == R6) && !(cur == R5 && lo) && !lo …"];
  "R2" -> "R3" [label="!(cur == OVF) && !(cur == R6) && !(cur == R5 && lo) && !lo …"];
  "R3" -> "R4" [label="!(cur == OVF) && !(cur == R6) && !(cur == R5 && lo) && !lo …"];
  "R4" -> "R5" [label="!(cur == OVF) && !(cur == R6) && !(cur == R5 && lo) && !lo …"];
  "R5" -> "R6" [label="!(cur == OVF) && !(cur == R6) && !(cur == R5 && lo) && !lo …"];
  "__any" -> "R1" [label="!(cur == OVF) && !(cur == R6) && !(cur == R5 && lo) && !lo …", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: disc(moore), err(moore), flag(moore)"];
}