digraph "axidma.phantom_read" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axidma.phantom_read (two-process, 1 states)";
  "0" [label="0"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "0" [label="phantom_read |\nfifo_space_available < MAXBURST |\nM_AXI_ARVALID && !M_AXI_ARREADY |\n(+3 more)", style=dashed, color="#e76f51"];
}