digraph "axidma.r_busy" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axidma.r_busy (one-process, 1 states)";
  __reset [shape=point, width=0.15];
  __reset -> "0" [label="reset"];
  "0" [peripheries=2, label="0"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "0" [label="!(!r_busy && axil_write_ready) && r_busy && M_AXI_BVALID &&… |\n!(!r_busy && axil_write_ready) && r_busy && r_done", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: M_AXI_ARADDR(moore), M_AXI_ARLEN(moore), M_AXI_ARVALID(moore), M_AXI_AWADDR(moore), M_AXI_AWLEN(moore), M_AXI_WLAST(moore), S_AXIL_RDATA(moore), o_int(moore)"];
}