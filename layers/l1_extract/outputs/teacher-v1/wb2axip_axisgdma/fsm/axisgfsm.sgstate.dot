digraph "axisgfsm.sgstate" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axisgfsm.sgstate (one-process, 8 states)";
  __reset [shape=point, width=0.15];
  __reset -> "SG_IDLE" [label="reset"];
  "SG_IDLE" [peripheries=2, label="SG_IDLE"];
  "SG_SRCHALF" [label="SG_SRCHALF"];
  "SG_SRCADDR" [label="SG_SRCADDR"];
  "SG_DSTHALF" [label="SG_DSTHALF"];
  "SG_DSTADDR" [label="SG_DSTADDR"];
  "SG_LENGTH" [label="SG_LENGTH"];
  "SG_CONTROL" [label="SG_CONTROL"];
  "SG_WAIT" [label="SG_WAIT"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "SG_IDLE" -> "SG_SRCHALF" [label="i_start"];
  "SG_SRCHALF" -> "SG_SRCADDR" [label="i_pf_valid && (!o_dmac_wvalid || i_dmac_wready)"];
  "SG_SRCADDR" -> "SG_DSTHALF" [label="i_pf_valid && o_pf_ready"];
  "SG_SRCADDR" -> "SG_SRCHALF" [label="i_pf_valid && o_pf_ready && i_pf_insn[31:30] == 2'b10 |\ni_pf_valid && o_pf_ready && i_pf_insn[31:30] == 2'b11"];
  "SG_DSTHALF" -> "SG_DSTADDR" [label="i_pf_valid && (!o_dmac_wvalid || i_dmac_wready)"];
  "SG_DSTADDR" -> "SG_LENGTH" [label="i_pf_valid && (!o_dmac_wvalid || i_dmac_wready)"];
  "SG_LENGTH" -> "SG_CONTROL" [label="i_pf_valid && (!o_dmac_wvalid || i_dmac_wready)"];
  "SG_LENGTH" -> "SG_IDLE" [label="i_pf_valid && (!o_dmac_wvalid || i_dmac_wready) && i_pf_ins…"];
  "SG_LENGTH" -> "SG_SRCADDR" [label="i_pf_valid && (!o_dmac_wvalid || i_dmac_wready) && i_pf_ins…"];
  "SG_CONTROL" -> "SG_WAIT" [label="(!o_dmac_wvalid || i_dmac_wready)"];
  "SG_WAIT" -> "SG_IDLE" [label="dma_op_complete && dma_terminate"];
  "SG_WAIT" -> "SG_SRCHALF" [label="dma_op_complete && !dma_terminate"];
  "__any" -> "SG_IDLE" [label="i_pf_valid && i_pf_illegal && sgstate != SG_CONTROL && sgst… |\ni_abort && (!o_dmac_wvalid || i_dmac_wready) && !dma_busy &…", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: o_busy(moore), o_dmac_waddr(moore), o_dmac_wdata(moore), o_dmac_wvalid(moore), o_done(moore), o_err(moore), o_int(mealy), o_new_pc(moore), o_pf_clear_cache(moore), o_pf_ready(mealy), o_tbl_addr(moore)"];
}