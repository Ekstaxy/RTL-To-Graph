  __reset -> "S_0" [label="reset"];
  "S_0" [peripheries=2, label="S_0"];
  "S_2" [label="S_2"];
  "S_3" [label="S_3"];
  "S_0" -> "S_2" [label="<datapath condition>"];
  "S_2" -> "S_0" [label="(!err_state && i_axi_bready && !o_wb_stb) || (!err_state &&…"];
  "S_2" -> "S_3" [label="(err_state && !o_axi_bvalid && !wb_pending && !i_wb_err) ||…"];
  "S_3" -> "S_0" [label="(!err_state && i_axi_bready && !o_wb_stb) || (!err_state &&…"];
