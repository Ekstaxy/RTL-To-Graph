digraph "axis_tap.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_tap.state_reg (two-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_TRANSFER" [label="STATE_TRANSFER"];
  "STATE_WAIT" [label="STATE_WAIT"];
  "STATE_TRUNCATE" [label="STATE_TRUNCATE"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_TRANSFER" [label="tap_axis_tready && tap_axis_tvalid && m_axis_tready_int_reg…"];
  "STATE_IDLE" -> "STATE_WAIT" [label="tap_axis_tready && tap_axis_tvalid && !m_axis_tready_int_reg"];
  "STATE_TRANSFER" -> "STATE_IDLE" [label="tap_axis_tready && tap_axis_tvalid && m_axis_tready_int_reg…"];
  "STATE_TRANSFER" -> "STATE_TRUNCATE" [label="tap_axis_tready && tap_axis_tvalid && !m_axis_tready_int_reg"];
  "STATE_TRUNCATE" -> "STATE_WAIT" [label="m_axis_tready_int_reg && frame_next"];
  "STATE_TRUNCATE" -> "STATE_IDLE" [label="m_axis_tready_int_reg && !frame_next"];
  "STATE_WAIT" -> "STATE_IDLE" [label="tap_axis_tready && tap_axis_tvalid && tap_axis_tlast"];
}