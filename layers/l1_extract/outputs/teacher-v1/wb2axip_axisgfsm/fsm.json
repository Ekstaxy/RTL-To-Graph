   }
  ],
  "reset_state": "SG_IDLE",
  "transitions": [
   {
    "src": "SG_IDLE",
    "dst": "SG_SRCADDR",
    "cond": "i_start"
   },
   {
    "src": "SG_SRCHALF",
    "dst": "SG_SRCADDR",
    "cond": "i_pf_valid && (!o_dmac_wvalid || i_dmac_wready)"
   },
   {
    "src": "SG_SRCADDR",
    "dst": "SG_DSTADDR",
    "cond": "i_pf_valid && o_pf_ready"
   },
   {
    "src": "SG_SRCADDR",
    "dst": "SG_SRCADDR",
    "cond": "i_pf_valid && o_pf_ready && i_pf_insn[31:30] == 2'b10"
   },
   {
    "src": "SG_SRCADDR",
    "dst": "SG_SRCADDR",
    "cond": "i_pf_valid && o_pf_ready && i_pf_insn[31:30] == 2'b11"
   },
   {
    "src": "SG_DSTHALF",
    "dst": "SG_DSTADDR",
    "cond": "i_pf_valid && (!o_dmac_wvalid || i_dmac_wready)"
   },
   {
    "src": "SG_DSTADDR",
    "dst": "SG_LENGTH",
    "cond": "i_pf_valid && (!o_dmac_wvalid || i_dmac_wready)"
   },
   {
    "src": "SG_LENGTH",
    "dst": "SG_CONTROL",
    "cond": "i_pf_valid && (!o_dmac_wvalid || i_dmac_wready)"
   },
   {
    "src": "SG_LENGTH",
    "dst": "SG_IDLE",
    "cond": "i_pf_valid && (!o_dmac_wvalid || i_dmac_wready) && i_pf_insn <= 0 && tbl_last"
   },
   {
    "src": "SG_LENGTH",
    "dst": "SG_SRCADDR",
    "cond": "i_pf_valid && (!o_dmac_wvalid || i_dmac_wready) && i_pf_insn <= 0 && !tbl_last"
   },
   {
    "src": "SG_CONTROL",
    "dst": "SG_WAIT",
    "cond": "(!o_dmac_wvalid || i_dmac_wready)"
   },
   {
    "src": "SG_WAIT",
    "dst": "SG_IDLE",
    "cond": "dma_op_complete && dma_terminate"
   },
   {
    "src": "SG_WAIT",
    "dst": "SG_SRCADDR",
    "cond": "dma_op_complete && !dma_terminate"
   },
   {
    "src": "*",
    "dst": "SG_IDLE",
    "cond": "i_pf_valid && i_pf_illegal && sgstate != SG_CONTROL && sgstate != SG_WAIT && !o_new_pc && !o_pf_clear_cache"
   },
   {
    "src": "*",
    "dst": "SG_IDLE",
    "cond": "i_abort && (!o_dmac_wvalid || i_dmac_wready) && !dma_busy && (sgstate != SG_WAIT)"
   }
  ],
  "outputs": [
