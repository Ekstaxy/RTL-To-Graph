digraph "axi_vfifo_raw_wr.wr_burst_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axi_vfifo_raw_wr.wr_burst_reg (two-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "0" [label="reset"];
  "1" [label="1"];
  "0" [peripheries=2, label="0"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "1" [label="!m_axi_awvalid_reg && !wr_burst_reg && cfg_enable && input_…", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: sts_write_active(moore)"];
}