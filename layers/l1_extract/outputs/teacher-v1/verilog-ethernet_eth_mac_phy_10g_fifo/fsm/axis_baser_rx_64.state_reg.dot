digraph "axis_baser_rx_64.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_baser_rx_64.state_reg (two-process, 3 states)";
  "STATE_IDLE" [label="STATE_IDLE"];
  "STATE_PAYLOAD" [label="STATE_PAYLOAD"];
  "STATE_LAST" [label="STATE_LAST"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_PAYLOAD" [label="input_type_d1 == INPUT_TYPE_START_0 && cfg_rx_enable"];
  "STATE_PAYLOAD" -> "STATE_IDLE" [label="!(input_type_d0 == INPUT_TYPE_DATA) && input_type_d0[3] && … |\n!(input_type_d0 == INPUT_TYPE_DATA) && !input_type_d0[3]"];
  "STATE_PAYLOAD" -> "STATE_LAST" [label="!(input_type_d0 == INPUT_TYPE_DATA) && input_type_d0[3] && …"];
  "STATE_LAST" -> "STATE_IDLE" [label=""];
  __outs [shape=note, fontsize=9, label="outputs: m_axis_tvalid_next(moore)"];
}