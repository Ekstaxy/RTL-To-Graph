digraph "axis_gmii_rx.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_gmii_rx.state_reg (two-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_PAYLOAD" [label="STATE_PAYLOAD"];
  "STATE_WAIT_LAST" [label="STATE_WAIT_LAST"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_PAYLOAD" [label="clk_enable && !(mii_select && !mii_odd) && gmii_rx_dv_d4 &&…"];
  "STATE_PAYLOAD" -> "STATE_WAIT_LAST" [label="clk_enable && !(mii_select && !mii_odd) && gmii_rx_dv_d4 &&…"];
  "STATE_PAYLOAD" -> "STATE_IDLE" [label="clk_enable && !(mii_select && !mii_odd) && !(gmii_rx_dv_d4 …"];
  "STATE_WAIT_LAST" -> "STATE_IDLE" [label="clk_enable && !(mii_select && !mii_odd) && ~gmii_rx_dv"];
}