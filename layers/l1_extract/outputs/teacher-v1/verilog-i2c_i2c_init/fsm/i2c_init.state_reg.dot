digraph "i2c_init.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="i2c_init.state_reg (two-process, 5 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_RUN" [label="STATE_RUN"];
  "STATE_TABLE_1" [label="STATE_TABLE_1"];
  "STATE_TABLE_2" [label="STATE_TABLE_2"];
  "STATE_TABLE_3" [label="STATE_TABLE_3"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_RUN" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_RUN" -> "STATE_TABLE_1" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_RUN" -> "STATE_IDLE" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_TABLE_1" -> "STATE_TABLE_2" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_TABLE_1" -> "STATE_RUN" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_TABLE_1" -> "STATE_IDLE" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_TABLE_2" -> "STATE_TABLE_3" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_TABLE_2" -> "STATE_TABLE_1" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_TABLE_2" -> "STATE_RUN" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_TABLE_2" -> "STATE_IDLE" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_TABLE_3" -> "STATE_TABLE_1" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_TABLE_3" -> "STATE_TABLE_2" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_TABLE_3" -> "STATE_RUN" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
  "STATE_TABLE_3" -> "STATE_IDLE" [label="!(m_axis_cmd_valid | m_axis_data_tvalid) && !(delay_counter…"];
}