digraph "axivfifo.phantom_read" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axivfifo.phantom_read (two-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "0" [label="reset"];
  "1" [label="1"];
  "0" [peripheries=2, label="0"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "1" [label="", style=dashed, color="#e76f51"];
  "__any" -> "0" [label="ofifo_space_available < MAXBURST |\n!M_AXI_BVALID && mem_data_available_w == 0 |\n(soft_reset || phantom_read) |\n(+2 more)", style=dashed, color="#e76f51"];
}