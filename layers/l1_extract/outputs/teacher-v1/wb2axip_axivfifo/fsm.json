[
 {
  "module": "axivfifo",
  "instance": "axivfifo",
  "state": "phantom_write",
  "next": "start_write",
  "style": "two-process",
  "states": [
   {
    "name": "0",
    "value": "0"
   },
   {
    "name": "1",
    "value": "1"
   }
  ],
  "reset_state": "0",
  "transitions": [
   {
    "src": "*",
    "dst": "0",
    "cond": "1"
   },
   {
    "src": "*",
    "dst": "1",
    "cond": "ififo_fill >= (1<<LGMAXBURST)"
   },
   {
    "src": "*",
    "dst": "0",
    "cond": "((vfifo_full || soft_reset) || phantom_write)"
   },
   {
    "src": "*",
    "dst": "0",
    "cond": "mem_space_available_w == 0"
   },
   {
    "src": "*",
    "dst": "0",
    "cond": "M_AXI_WVALID && (!M_AXI_WREADY || !M_AXI_WLAST)"
   },
   {
    "src": "*",
    "dst": "0",
    "cond": "M_AXI_AWVALID && !M_AXI_AWREADY"
   },
   {
    "src": "*",
    "dst": "0",
    "cond": "o_err"
   }
  ],
  "outputs": [],
  "warnings": [],
  "semantic_check": "consistent"
 },
 {
  "module": "axivfifo",
  "instance": "axivfifo",
  "state": "phantom_read",
  "next": "start_read",
  "style": "two-process",
  "states": [
   {
    "name": "1",
    "value": "1"
   },
   {
    "name": "0",
    "value": "0"
   }
  ],
  "reset_state": "0",
  "transitions": [
   {
    "src": "*",
    "dst": "1",
    "cond": "1"
   },
   {
    "src": "*",
    "dst": "0",
    "cond": "ofifo_space_available < MAXBURST"
   },
   {
    "src": "*",
    "dst": "0",
    "cond": "!M_AXI_BVALID && mem_data_available_w == 0"
   },
   {
    "src": "*",
    "dst": "0",
    "cond": "(soft_reset || phantom_read)"
   },
   {
    "src": "*",
    "dst": "0",
    "cond": "M_AXI_ARVALID && !M_AXI_ARREADY"
   },
   {
    "src": "*",
    "dst": "0",
    "cond": "o_err"
   }
  ],
  "outputs": [],
  "warnings": [],
  "semantic_check": "consistent"
 }
]