digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (two-process, 9 states)";
  __reset [shape=point, width=0.15];
  __reset -> "A" [label="reset"];
  "A" [peripheries=2, label="A"];
  "B" [label="B"];
  "S0" [label="S0"];
  "S1" [label="S1"];
  "S10" [label="S10"];
  "G1" [label="G1"];
  "P1" [label="P1"];
  "G2" [label="G2"];
  "P0" [label="P0"];
  "A" -> "B" [label=""];
  "B" -> "S0" [label=""];
  "S0" -> "S1" [label="x"];
  "S1" -> "S10" [label="!x"];
  "S10" -> "G1" [label="x"];
  "S10" -> "S0" [label="!x"];
  "G1" -> "P1" [label="y"];
  "G1" -> "G2" [label="!y"];
  "G2" -> "P1" [label="y"];
  "G2" -> "P0" [label="!y"];
  __outs [shape=note, fontsize=9, label="outputs: f(moore), g(moore)"];
}