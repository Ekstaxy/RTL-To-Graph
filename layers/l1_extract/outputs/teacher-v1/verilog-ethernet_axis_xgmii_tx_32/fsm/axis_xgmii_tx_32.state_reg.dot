digraph "axis_xgmii_tx_32.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_xgmii_tx_32.state_reg (two-process, 9 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_PREAMBLE" [label="STATE_PREAMBLE"];
  "STATE_PAYLOAD" [label="STATE_PAYLOAD"];
  "STATE_PAD" [label="STATE_PAD"];
  "STATE_FCS_1" [label="STATE_FCS_1"];
  "STATE_ERR" [label="STATE_ERR"];
  "STATE_FCS_2" [label="STATE_FCS_2"];
  "STATE_FCS_3" [label="STATE_FCS_3"];
  "STATE_IFG" [label="STATE_IFG"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_PREAMBLE" [label="s_axis_tvalid && cfg_tx_enable"];
  "STATE_PREAMBLE" -> "STATE_PAYLOAD" [label=""];
  "STATE_PAYLOAD" -> "STATE_PAD" [label="(!s_axis_tvalid || s_axis_tlast) && frame_min_count_reg && …"];
  "STATE_PAYLOAD" -> "STATE_FCS_1" [label="(!s_axis_tvalid || s_axis_tlast) && frame_min_count_reg && … |\n(!s_axis_tvalid || s_axis_tlast) && !frame_min_count_reg"];
  "STATE_PAD" -> "STATE_FCS_1" [label="!(frame_min_count_reg > CTRL_WIDTH)"];
  "STATE_FCS_1" -> "STATE_ERR" [label="frame_error_reg"];
  "STATE_FCS_1" -> "STATE_FCS_2" [label="!frame_error_reg"];
  "STATE_FCS_2" -> "STATE_FCS_3" [label="extra_cycle"];
  "STATE_FCS_2" -> "STATE_IFG" [label="!extra_cycle"];
  "STATE_FCS_3" -> "STATE_IFG" [label="ifg_count_next > 8'd3"];
  "STATE_FCS_3" -> "STATE_IDLE" [label="!(ifg_count_next > 8'd3)"];
  "STATE_ERR" -> "STATE_IFG" [label=""];
  "STATE_IFG" -> "STATE_IDLE" [label="!(ifg_count_next > 8'd3 || frame_reg)"];
  __outs [shape=note, fontsize=9, label="outputs: reset_crc(moore), start_packet_next(moore), update_crc(moore)"];
}