digraph "axi_cdma.axi_state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axi_cdma.axi_state_reg (two-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "AXI_STATE_IDLE" [label="reset"];
  "AXI_STATE_IDLE" [peripheries=2, label="AXI_STATE_IDLE"];
  "AXI_STATE_WRITE" [label="AXI_STATE_WRITE"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "AXI_STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "AXI_STATE_IDLE" -> "AXI_STATE_WRITE" [label="!m_axi_awvalid && axi_cmd_valid_reg"];
  "AXI_STATE_WRITE" -> "AXI_STATE_IDLE" [label="(m_axi_rready && m_axi_rvalid || !input_active_reg) && outp…"];
}