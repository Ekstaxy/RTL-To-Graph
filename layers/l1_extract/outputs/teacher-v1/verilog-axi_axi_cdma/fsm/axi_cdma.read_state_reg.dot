digraph "axi_cdma.read_state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axi_cdma.read_state_reg (two-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "READ_STATE_IDLE" [label="reset"];
  "READ_STATE_IDLE" [peripheries=2, label="READ_STATE_IDLE"];
  "READ_STATE_START" [label="READ_STATE_START"];
  "READ_STATE_REQ" [label="READ_STATE_REQ"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "READ_STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "READ_STATE_IDLE" -> "READ_STATE_START" [label="s_axis_desc_ready && s_axis_desc_valid"];
  "READ_STATE_START" -> "READ_STATE_REQ" [label="!axi_cmd_valid_reg && active_count_av_reg"];
  "READ_STATE_REQ" -> "READ_STATE_START" [label="!m_axi_arvalid && !(axi_word_count_next > 0) && op_word_cou…"];
  "READ_STATE_REQ" -> "READ_STATE_IDLE" [label="!m_axi_arvalid && !(axi_word_count_next > 0) && !(op_word_c…"];
}