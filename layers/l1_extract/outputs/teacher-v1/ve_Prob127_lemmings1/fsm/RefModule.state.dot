digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (two-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "WL" [label="reset"];
  "WL" [peripheries=2, label="WL"];
  "WR" [label="WR"];
  "WL" -> "WR" [label="bump_left"];
  "WR" -> "WL" [label="bump_right"];
  __outs [shape=note, fontsize=9, label="outputs: walk_left(moore), walk_right(moore)"];
}