digraph "ugly_mul.st" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="ugly_mul.st (two-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "HOLD" [label="reset"];
  "SPIN" [label="SPIN"];
  "FIN" [label="FIN"];
  "HOLD" [peripheries=2, label="HOLD"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "SPIN" [label="st[0] && s", style=dashed, color="#e76f51"];
  "__any" -> "FIN" [label="!st[0] && st[1] && last", style=dashed, color="#e76f51"];
  "__any" -> "HOLD" [label="!st[0] && !st[1]", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: bz(moore), d(moore)"];
}