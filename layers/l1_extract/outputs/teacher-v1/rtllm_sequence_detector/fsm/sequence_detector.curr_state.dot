digraph "sequence_detector.curr_state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="sequence_detector.curr_state (two-process, 5 states)";
  __reset [shape=point, width=0.15];
  __reset -> "IDLE" [label="reset"];
  "IDLE" [peripheries=2, label="IDLE"];
  "S1" [label="S1"];
  "S2" [label="S2"];
  "S3" [label="S3"];
  "S4" [label="S4"];
  "IDLE" -> "S1" [label="data_in"];
  "S1" -> "S2" [label="!data_in"];
  "S2" -> "S1" [label="data_in"];
  "S2" -> "S3" [label="!data_in"];
  "S3" -> "S4" [label="data_in"];
  "S3" -> "IDLE" [label="!data_in"];
  "S4" -> "S1" [label="data_in"];
  "S4" -> "S2" [label="!data_in"];
  __outs [shape=note, fontsize=9, label="outputs: sequence_detected(moore)"];
}