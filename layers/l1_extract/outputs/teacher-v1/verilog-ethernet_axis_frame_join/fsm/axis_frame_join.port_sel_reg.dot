digraph "axis_frame_join.port_sel_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_frame_join.port_sel_reg (semantic, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "S_1" [label="S_1"];
  "S_2" [label="S_2"];
  "S_3" [label="S_3"];
  "STATE_IDLE" -> "S_1" [label="<datapath condition>"];
  "S_1" -> "STATE_IDLE" [label="<datapath condition>"];
  "S_1" -> "S_2" [label="<datapath condition>"];
  "S_2" -> "STATE_IDLE" [label="<datapath condition>"];
  "S_2" -> "S_3" [label="<datapath condition>"];
  "S_3" -> "STATE_IDLE" [label="<datapath condition>"];
}