digraph "cc_cdc_reset_ctrlr_half.receiver_phase_q" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="cc_cdc_reset_ctrlr_half.receiver_phase_q (one-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "CDC_CLEAR_PHASE_IDLE" [label="reset"];
  "CDC_CLEAR_PHASE_IDLE" [peripheries=2, label="CDC_CLEAR_PHASE_IDLE"];
  "CDC_CLEAR_PHASE_ISOLATE" [label="CDC_CLEAR_PHASE_ISOLATE"];
  "CDC_CLEAR_PHASE_CLEAR" [label="CDC_CLEAR_PHASE_CLEAR"];
  "CDC_CLEAR_PHASE_POST_CLEAR" [label="CDC_CLEAR_PHASE_POST_CLEAR"];
  __outs [shape=note, fontsize=9, label="outputs: receiver_effective_phase(moore)"];
}