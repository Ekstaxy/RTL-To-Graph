digraph "axis_cobs_decode.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_cobs_decode.state_reg (two-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_NEXT_SEGMENT" [label="STATE_NEXT_SEGMENT"];
  "STATE_SEGMENT" [label="STATE_SEGMENT"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_NEXT_SEGMENT" [label="s_axis_tready && s_axis_tvalid && s_axis_tdata != 8'd0 && s…"];
  "STATE_IDLE" -> "STATE_SEGMENT" [label="s_axis_tready && s_axis_tvalid && s_axis_tdata != 8'd0 && !…"];
  "STATE_SEGMENT" -> "STATE_IDLE" [label="s_axis_tready && s_axis_tvalid && s_axis_tdata == 8'd0 |\ns_axis_tready && s_axis_tvalid && !(s_axis_tdata == 8'd0) &… |\ns_axis_tready && s_axis_tvalid && !(s_axis_tdata == 8'd0) &…"];
  "STATE_SEGMENT" -> "STATE_NEXT_SEGMENT" [label="s_axis_tready && s_axis_tvalid && !(s_axis_tdata == 8'd0) &…"];
  "STATE_NEXT_SEGMENT" -> "STATE_IDLE" [label="s_axis_tready && s_axis_tvalid && s_axis_tdata == 8'd0 |\ns_axis_tready && s_axis_tvalid && !(s_axis_tdata == 8'd0) &… |\ns_axis_tready && s_axis_tvalid && !(s_axis_tdata == 8'd0) &…"];
  "STATE_NEXT_SEGMENT" -> "STATE_SEGMENT" [label="s_axis_tready && s_axis_tvalid && !(s_axis_tdata == 8'd0) &…"];
}