digraph "cache_ctrl.mode" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="cache_ctrl.mode (one-process, 5 states)";
  __reset [shape=point, width=0.15];
  __reset -> "M_WAIT" [label="reset"];
  "M_WAIT" [peripheries=2, label="M_WAIT"];
  "M_PEEK" [label="M_PEEK"];
  "M_PUSH" [label="M_PUSH"];
  "M_DONE" [label="M_DONE"];
  "M_PULL" [label="M_PULL"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "M_PEEK" [label="is_wait && cpu_req_valid", style=dashed, color="#e76f51"];
  "__any" -> "M_PUSH" [label="!is_wait && is_peek && lat_w", style=dashed, color="#e76f51"];
  "__any" -> "M_DONE" [label="!is_wait && is_peek && !lat_w && found |\n!is_wait && !is_peek && (is_push || is_pull) && mem_ack", style=dashed, color="#e76f51"];
  "__any" -> "M_PULL" [label="!is_wait && is_peek && !lat_w && !found", style=dashed, color="#e76f51"];
  "__any" -> "M_WAIT" [label="!is_wait && !is_peek && !(is_push || is_pull)", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: is_done(moore), is_peek(moore), is_pull(moore), is_push(moore), is_wait(moore)"];
}