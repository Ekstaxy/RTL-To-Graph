stateDiagram-v2
    [*] --> M_WAIT
    ANY_STATE --> M_PEEK : is_wait && cpu_req_valid
    ANY_STATE --> M_PUSH : !is_wait && is_peek && lat_w
    ANY_STATE --> M_DONE : !is_wait && is_peek && !lat_w && found
    ANY_STATE --> M_PULL : !is_wait && is_peek && !lat_w && !found
    ANY_STATE --> M_DONE : !is_wait && !is_peek && (is_push || is_pull) && mem_ack
    ANY_STATE --> M_WAIT : !is_wait && !is_peek && !(is_push || is_pull)
