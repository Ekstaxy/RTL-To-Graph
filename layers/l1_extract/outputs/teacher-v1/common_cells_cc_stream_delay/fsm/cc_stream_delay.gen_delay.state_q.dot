digraph "cc_stream_delay.gen_delay.state_q" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="cc_stream_delay.gen_delay.state_q (two-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "Idle" [label="reset"];
  "Idle" [peripheries=2, label="Idle"];
  "Valid" [label="Valid"];
  "Ready" [label="Ready"];
  "Idle" -> "Valid" [label="valid_i"];
  "Idle" -> "Ready" [label="valid_i"];
  "Valid" -> "Ready" [label="count_out == 0"];
  "Ready" -> "Idle" [label="ready_i"];
  __outs [shape=note, fontsize=9, label="outputs: ready_o(mealy), valid_o(mealy), en(moore)"];
}