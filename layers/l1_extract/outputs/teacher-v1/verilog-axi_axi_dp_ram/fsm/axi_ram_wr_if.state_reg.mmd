    STATE_BURST --> STATE_IDLE : s_axi_wready && s_axi_wvalid && !(write_count_reg > 0) && (s_axi_bready || !s_axi_bvalid)
    STATE_BURST --> STATE_RESP : s_axi_wready && s_axi_wvalid && !(write_count_reg > 0) && !(s_axi_bready || !s_axi_bvalid)
    STATE_BURST --> STATE_BURST : !(s_axi_wready && s_axi_wvalid)
    STATE_RESP --> STATE_IDLE : (s_axi_bready || !s_axi_bvalid)
    STATE_RESP --> STATE_RESP : !(s_axi_bready || !s_axi_bvalid)