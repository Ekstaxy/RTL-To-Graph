  "STATE_WRITE_PAYLOAD" -> "STATE_WRITE_PAYLOAD_LAST" [label="m_eth_payload_axis_tready_int_reg && shift_ip_payload_axis_…"];
  "STATE_WRITE_PAYLOAD_LAST" -> "STATE_IDLE" [label="m_eth_payload_axis_tready_int_reg && shift_ip_payload_axis_…"];
