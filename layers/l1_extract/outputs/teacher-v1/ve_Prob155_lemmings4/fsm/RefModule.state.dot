digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (two-process, 7 states)";
  __reset [shape=point, width=0.15];
  __reset -> "WL" [label="reset"];
  "WL" [peripheries=2, label="WL"];
  "FALLL" [label="FALLL"];
  "DIGL" [label="DIGL"];
  "WR" [label="WR"];
  "FALLR" [label="FALLR"];
  "DIGR" [label="DIGR"];
  "DEAD" [label="DEAD"];
  "WL" -> "FALLL" [label="!ground"];
  "WL" -> "DIGL" [label="ground && dig"];
  "WL" -> "WR" [label="ground && !dig && bump_left"];
  "WR" -> "FALLR" [label="!ground"];
  "WR" -> "DIGR" [label="ground && dig"];
  "WR" -> "WL" [label="ground && !dig && bump_right"];
  "FALLL" -> "DEAD" [label="ground && fall_counter >= 20"];
  "FALLL" -> "WL" [label="ground && !(fall_counter >= 20)"];
  "FALLR" -> "DEAD" [label="ground && fall_counter >= 20"];
  "FALLR" -> "WR" [label="ground && !(fall_counter >= 20)"];
  "DIGL" -> "FALLL" [label="!ground"];
  "DIGR" -> "FALLR" [label="!ground"];
  __outs [shape=note, fontsize=9, label="outputs: aaah(moore), digging(moore), walk_left(moore), walk_right(moore)"];
}