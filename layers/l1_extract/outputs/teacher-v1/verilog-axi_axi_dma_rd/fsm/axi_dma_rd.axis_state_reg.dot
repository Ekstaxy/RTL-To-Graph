digraph "axi_dma_rd.axis_state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axi_dma_rd.axis_state_reg (two-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "AXIS_STATE_IDLE" [label="reset"];
  "AXIS_STATE_IDLE" [peripheries=2, label="AXIS_STATE_IDLE"];
  "AXIS_STATE_READ" [label="AXIS_STATE_READ"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "AXIS_STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "AXIS_STATE_IDLE" -> "AXIS_STATE_READ" [label="axis_cmd_valid_reg"];
  "AXIS_STATE_READ" -> "AXIS_STATE_IDLE" [label="(m_axi_rready && m_axi_rvalid || !input_active_reg) && outp…"];
}