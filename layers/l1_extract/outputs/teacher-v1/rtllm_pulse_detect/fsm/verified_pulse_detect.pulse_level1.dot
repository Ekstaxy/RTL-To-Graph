digraph "verified_pulse_detect.pulse_level1" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="verified_pulse_detect.pulse_level1 (two-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "s0" [label="reset"];
  "s0" [peripheries=2, label="s0"];
  "s1" [label="s1"];
  "s2" [label="s2"];
  "s3" [label="s3"];
  "s0" -> "s1" [label="data_in == 0"];
  "s1" -> "s2" [label="data_in == 1"];
  "s2" -> "s3" [label="data_in == 0"];
  "s2" -> "s0" [label="!(data_in == 0)"];
  "s3" -> "s2" [label="data_in == 1"];
  "s3" -> "s1" [label="!(data_in == 1)"];
  __outs [shape=note, fontsize=9, label="outputs: data_out(mealy)"];
}