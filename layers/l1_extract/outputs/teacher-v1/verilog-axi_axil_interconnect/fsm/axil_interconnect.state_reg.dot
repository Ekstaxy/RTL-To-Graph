digraph "axil_interconnect.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axil_interconnect.state_reg (two-process, 7 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_DECODE" [label="STATE_DECODE"];
  "STATE_READ" [label="STATE_READ"];
  "STATE_WRITE" [label="STATE_WRITE"];
  "STATE_WAIT_IDLE" [label="STATE_WAIT_IDLE"];
  "STATE_WRITE_DROP" [label="STATE_WRITE_DROP"];
  "STATE_WRITE_RESP" [label="STATE_WRITE_RESP"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_DECODE" [label="grant_valid"];
  "STATE_DECODE" -> "STATE_READ" [label="match && read"];
  "STATE_DECODE" -> "STATE_WRITE" [label="match && !read"];
  "STATE_DECODE" -> "STATE_WAIT_IDLE" [label="!match && read"];
  "STATE_DECODE" -> "STATE_WRITE_DROP" [label="!match && !read"];
  "STATE_WRITE" -> "STATE_WRITE_RESP" [label="current_s_axil_wready && current_s_axil_wvalid"];
  "STATE_WRITE_RESP" -> "STATE_WAIT_IDLE" [label="current_m_axil_bready && current_m_axil_bvalid"];
  "STATE_WRITE_DROP" -> "STATE_WAIT_IDLE" [label="current_s_axil_wready && current_s_axil_wvalid"];
  "STATE_READ" -> "STATE_WAIT_IDLE" [label="current_m_axil_rready && current_m_axil_rvalid"];
  "STATE_WAIT_IDLE" -> "STATE_IDLE" [label="(!grant_valid || acknowledge)"];
  __outs [shape=note, fontsize=9, label="outputs: i(moore)"];
}