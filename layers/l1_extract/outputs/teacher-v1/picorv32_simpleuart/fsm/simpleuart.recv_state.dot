digraph "simpleuart.recv_state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="simpleuart.recv_state (one-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "0" [label="reset"];
  "0" [peripheries=2, label="0"];
  "1" [label="1"];
  "2" [label="2"];
  "10" [label="10"];
  "0" -> "1" [label="!ser_rx"];
  "1" -> "2" [label="2*recv_divcnt > cfg_divider"];
  "10" -> "0" [label="recv_divcnt > cfg_divider"];
}