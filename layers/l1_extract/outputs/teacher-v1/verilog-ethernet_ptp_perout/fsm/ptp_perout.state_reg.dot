digraph "ptp_perout.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="ptp_perout.state_reg (two-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_UPDATE_RISE" [label="STATE_UPDATE_RISE"];
  "STATE_UPDATE_FALL" [label="STATE_UPDATE_FALL"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_UPDATE_RISE" [label="((time_s_reg > next_edge_s_reg) || time_s_reg == next_edge_…"];
  "STATE_IDLE" -> "STATE_UPDATE_FALL" [label="((time_s_reg > next_edge_s_reg) || time_s_reg == next_edge_…"];
  "STATE_UPDATE_RISE" -> "STATE_IDLE" [label=""];
  "STATE_UPDATE_FALL" -> "STATE_IDLE" [label=""];
}