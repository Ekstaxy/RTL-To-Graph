digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (two-process, 8 states)";
  __reset [shape=point, width=0.15];
  __reset -> "A" [label="reset"];
  "A" [peripheries=2, label="A"];
  "B" [label="B"];
  "S11" [label="S11"];
  "S10" [label="S10"];
  "C" [label="C"];
  "S21" [label="S21"];
  "S20" [label="S20"];
  "S22" [label="S22"];
  "A" -> "B" [label="s"];
  "B" -> "S11" [label="w"];
  "B" -> "S10" [label="!w"];
  "C" -> "S11" [label="w"];
  "C" -> "S10" [label="!w"];
  "S10" -> "S21" [label="w"];
  "S10" -> "S20" [label="!w"];
  "S11" -> "S22" [label="w"];
  "S11" -> "S21" [label="!w"];
  "S20" -> "B" [label=""];
  "S21" -> "C" [label="w"];
  "S21" -> "B" [label="!w"];
  "S22" -> "B" [label="w"];
  "S22" -> "C" [label="!w"];
  __outs [shape=note, fontsize=9, label="outputs: z(moore)"];
}