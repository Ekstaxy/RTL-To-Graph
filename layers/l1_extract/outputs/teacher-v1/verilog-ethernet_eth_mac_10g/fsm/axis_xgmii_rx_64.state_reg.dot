digraph "axis_xgmii_rx_64.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_xgmii_rx_64.state_reg (two-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_PAYLOAD" [label="STATE_PAYLOAD"];
  "STATE_LAST" [label="STATE_LAST"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_PAYLOAD" [label="xgmii_start_d1 && cfg_rx_enable"];
  "STATE_PAYLOAD" -> "STATE_IDLE" [label="(framing_error_reg || framing_error_d0_reg) |\n!(framing_error_reg || framing_error_d0_reg) && term_presen…"];
  "STATE_PAYLOAD" -> "STATE_LAST" [label="!(framing_error_reg || framing_error_d0_reg) && term_presen…"];
  "STATE_LAST" -> "STATE_PAYLOAD" [label="xgmii_start_d1 && cfg_rx_enable"];
  "STATE_LAST" -> "STATE_IDLE" [label="!(xgmii_start_d1 && cfg_rx_enable)"];
  __outs [shape=note, fontsize=9, label="outputs: m_axis_tvalid_next(moore)"];
}