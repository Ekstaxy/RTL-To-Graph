  "STATE_IDLE" -> "STATE_WRITE_HEADER" [label="s_udp_hdr_ready && s_udp_hdr_valid"];
  "STATE_IDLE" -> "STATE_WRITE_PAYLOAD" [label="s_udp_hdr_ready && s_udp_hdr_valid && m_ip_payload_axis_tre…"];
