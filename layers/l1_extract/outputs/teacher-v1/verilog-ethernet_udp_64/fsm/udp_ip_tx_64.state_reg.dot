  "STATE_WRITE_PAYLOAD" -> "STATE_WRITE_PAYLOAD_LAST" [label="m_ip_payload_axis_tready_int_reg && s_udp_payload_axis_tval…"];
  "STATE_WRITE_PAYLOAD_LAST" -> "STATE_IDLE" [label="s_udp_payload_axis_tready && s_udp_payload_axis_tvalid && s…"];
  "STATE_WAIT_LAST" -> "STATE_IDLE" [label="s_udp_payload_axis_tvalid && s_udp_payload_axis_tlast"];
  __outs [shape=note, fontsize=9, label="outputs: store_last_word(moore)"];
}