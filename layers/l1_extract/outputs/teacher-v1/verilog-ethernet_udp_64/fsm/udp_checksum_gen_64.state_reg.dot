digraph "udp_checksum_gen_64.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="udp_checksum_gen_64.state_reg (two-process, 5 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_SUM_HEADER" [label="STATE_SUM_HEADER"];
  "STATE_SUM_PAYLOAD" [label="STATE_SUM_PAYLOAD"];
  "STATE_FINISH_SUM_1" [label="STATE_FINISH_SUM_1"];
  "STATE_FINISH_SUM_2" [label="STATE_FINISH_SUM_2"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_SUM_HEADER" [label="s_udp_hdr_ready && s_udp_hdr_valid"];
  "STATE_SUM_HEADER" -> "STATE_SUM_PAYLOAD" [label=""];
  "STATE_SUM_PAYLOAD" -> "STATE_FINISH_SUM_1" [label="s_udp_payload_axis_tready && s_udp_payload_axis_tvalid && s…"];
  "STATE_FINISH_SUM_1" -> "STATE_FINISH_SUM_2" [label=""];
  "STATE_FINISH_SUM_2" -> "STATE_IDLE" [label=""];
  __outs [shape=note, fontsize=9, label="outputs: hdr_valid_next(moore), shift_payload_in(moore)"];
}