digraph "spimemio.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="spimemio.state (one-process, 13 states)";
  "0" [label="0"];
  "1" [label="1"];
  "2" [label="2"];
  "3" [label="3"];
  "4" [label="4"];
  "5" [label="5"];
  "6" [label="6"];
  "7" [label="7"];
  "8" [label="8"];
  "9" [label="9"];
  "10" [label="10"];
  "11" [label="11"];
  "12" [label="12"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "0" [label="(!resetn || softreset)", style=dashed, color="#e76f51"];
  "0" -> "1" [label="!(!resetn || softreset) && din_ready"];
  "1" -> "2" [label="!(!resetn || softreset) && dout_valid"];
  "2" -> "3" [label="!(!resetn || softreset) && din_ready"];
  "3" -> "4" [label="!(!resetn || softreset) && dout_valid"];
  "4" -> "5" [label="!(!resetn || softreset) && din_ready"];
  "5" -> "6" [label="!(!resetn || softreset) && valid && !ready && din_ready"];
  "6" -> "7" [label="!(!resetn || softreset) && din_ready"];
  "7" -> "8" [label="!(!resetn || softreset) && din_ready && (config_qspi || con…"];
  "7" -> "9" [label="!(!resetn || softreset) && din_ready && !(config_qspi || co…"];
  "8" -> "9" [label="!(!resetn || softreset) && din_ready"];
  "9" -> "10" [label="!(!resetn || softreset) && din_ready"];
  "10" -> "11" [label="!(!resetn || softreset) && din_ready"];
  "11" -> "12" [label="!(!resetn || softreset) && din_ready"];
  "12" -> "9" [label="!(!resetn || softreset) && (!rd_wait || valid) && din_ready"];
  "__any" -> "5" [label="!(!resetn || softreset) && jump && config_cont", style=dashed, color="#e76f51"];
  "__any" -> "4" [label="!(!resetn || softreset) && jump && !config_cont", style=dashed, color="#e76f51"];
}