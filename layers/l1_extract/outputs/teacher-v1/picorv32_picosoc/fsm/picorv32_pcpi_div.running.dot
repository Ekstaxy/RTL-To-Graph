digraph "picorv32_pcpi_div.running" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="picorv32_pcpi_div.running (one-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "0" [label="reset"];
  "0" [peripheries=2, label="0"];
  "1" [label="1"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "1" [label="start", style=dashed, color="#e76f51"];
  "__any" -> "0" [label="!start && !quotient_msk && running", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: pcpi_rd(moore), pcpi_ready(moore), pcpi_wr(moore)"];
}