digraph "picorv32.irq_state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="picorv32.irq_state (one-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "0" [label="reset"];
  "0" [peripheries=2, label="0"];
  "1" [label="1"];
  "2" [label="2"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "1" [label="cpu_state == cpu_state_fetch && (decoder_trigger && !irq_ac…", style=dashed, color="#e76f51"];
  "__any" -> "2" [label="cpu_state == cpu_state_fetch && (decoder_trigger && !irq_ac…", style=dashed, color="#e76f51"];
  "__any" -> "0" [label="cpu_state == cpu_state_fetch && (decoder_trigger && !irq_ac…", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: eoi(moore)"];
}