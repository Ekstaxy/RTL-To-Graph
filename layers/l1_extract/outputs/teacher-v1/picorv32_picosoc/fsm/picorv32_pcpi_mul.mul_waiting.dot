digraph "picorv32_pcpi_mul.mul_waiting" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="picorv32_pcpi_mul.mul_waiting (one-process, 1 states)";
  __reset [shape=point, width=0.15];
  __reset -> "1" [label="reset"];
  "1" [peripheries=2, label="1"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "1" [label="!mul_waiting && mul_counter[6]", style=dashed, color="#e76f51"];
}