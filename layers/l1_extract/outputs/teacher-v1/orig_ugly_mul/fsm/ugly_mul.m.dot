digraph "ugly_mul.m" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="ugly_mul.m (one-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "I" [label="reset"];
  "I" [peripheries=2, label="I"];
  "R" [label="R"];
  "F" [label="F"];
  "I" -> "R" [label="s"];
  "R" -> "F" [label="z"];
  "F" -> "I" [label=""];
  __outs [shape=note, fontsize=9, label="outputs: bz(moore), d(moore)"];
}