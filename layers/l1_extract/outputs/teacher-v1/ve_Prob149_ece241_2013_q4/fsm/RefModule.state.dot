digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (two-process, 6 states)";
  __reset [shape=point, width=0.15];
  __reset -> "A2" [label="reset"];
  "A2" [peripheries=2, label="A2"];
  "B1" [label="B1"];
  "C1" [label="C1"];
  "B2" [label="B2"];
  "D1" [label="D1"];
  "C2" [label="C2"];
  "A2" -> "B1" [label="s[0]"];
  "B1" -> "C1" [label="s[1]"];
  "B1" -> "A2" [label="!s[1] && !s[0]"];
  "B2" -> "C1" [label="s[1]"];
  "B2" -> "A2" [label="!s[1] && !s[0]"];
  "C1" -> "D1" [label="s[2]"];
  "C1" -> "B2" [label="!s[2] && !s[1]"];
  "C2" -> "D1" [label="s[2]"];
  "C2" -> "B2" [label="!s[2] && !s[1]"];
  "D1" -> "C2" [label="!s[2]"];
  __outs [shape=note, fontsize=9, label="outputs: fr(moore)"];
}