  __reset -> "0" [label="reset"];
  "0" [peripheries=2, label="0"];
  __outs [shape=note, fontsize=9, label="outputs: o_bufreg_en(mealy), o_dbus_cyc(mealy), o_init(mealy), o_mdu_valid(mealy), o_rf_wreq(mealy)"];
