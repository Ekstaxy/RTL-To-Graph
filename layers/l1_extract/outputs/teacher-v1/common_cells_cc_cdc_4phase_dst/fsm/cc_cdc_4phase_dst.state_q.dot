digraph "cc_cdc_4phase_dst.state_q" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="cc_cdc_4phase_dst.state_q (two-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "IDLE" [label="reset"];
  "IDLE" [peripheries=2, label="IDLE"];
  "WAIT_DOWNSTREAM_ACK" [label="WAIT_DOWNSTREAM_ACK"];
  "WAIT_REQ_DEASSERT" [label="WAIT_REQ_DEASSERT"];
  "IDLE" -> "WAIT_REQ_DEASSERT" [label="req_synced == 1'b1 && output_ready == 1'b1"];
  "IDLE" -> "WAIT_DOWNSTREAM_ACK" [label="req_synced == 1'b1 && !(output_ready == 1'b1)"];
  "WAIT_DOWNSTREAM_ACK" -> "WAIT_REQ_DEASSERT" [label="output_ready == 1'b1"];
  "WAIT_REQ_DEASSERT" -> "IDLE" [label="req_synced == 1'b0"];
}