digraph "uart_tx.phase_r" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="uart_tx.phase_r (one-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "PH_REST" [label="reset"];
  "PH_REST" [peripheries=2, label="PH_REST"];
  "PH_LEAD" [label="PH_LEAD"];
  "PH_BODY" [label="PH_BODY"];
  "PH_TAIL" [label="PH_TAIL"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "PH_LEAD" [label="phase_r[0] && tx_valid", style=dashed, color="#e76f51"];
  "__any" -> "PH_BODY" [label="!phase_r[0] && phase_r[1] && strobe", style=dashed, color="#e76f51"];
  "__any" -> "PH_TAIL" [label="!phase_r[0] && !phase_r[1] && phase_r[2] && strobe && &nib", style=dashed, color="#e76f51"];
  "__any" -> "PH_REST" [label="!phase_r[0] && !phase_r[1] && !phase_r[2] && strobe", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: tx_o(moore), at_rest(moore)"];
}