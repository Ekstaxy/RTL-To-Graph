digraph "i2c_single_reg.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="i2c_single_reg.state_reg (one-process, 8 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_ADDRESS" [label="STATE_ADDRESS"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_ACK" [label="STATE_ACK"];
  "STATE_READ_1" [label="STATE_READ_1"];
  "STATE_WRITE_1" [label="STATE_WRITE_1"];
  "STATE_WRITE_2" [label="STATE_WRITE_2"];
  "STATE_READ_2" [label="STATE_READ_2"];
  "STATE_READ_3" [label="STATE_READ_3"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_ADDRESS" [label="start_bit", style=dashed, color="#e76f51"];
  "__any" -> "STATE_IDLE" [label="!start_bit && stop_bit", style=dashed, color="#e76f51"];
  "STATE_ADDRESS" -> "STATE_ACK" [label="!start_bit && !stop_bit && scl_posedge && !(bit_count_reg >…"];
  "STATE_ADDRESS" -> "STATE_IDLE" [label="!start_bit && !stop_bit && scl_posedge && !(bit_count_reg >…"];
  "STATE_ACK" -> "STATE_READ_1" [label="!start_bit && !stop_bit && scl_negedge && mode_read_reg"];
  "STATE_ACK" -> "STATE_WRITE_1" [label="!start_bit && !stop_bit && scl_negedge && !mode_read_reg"];
  "STATE_WRITE_1" -> "STATE_WRITE_2" [label="!start_bit && !stop_bit && scl_negedge"];
  "STATE_WRITE_2" -> "STATE_ACK" [label="!start_bit && !stop_bit && scl_posedge && !(bit_count_reg >…"];
  "STATE_READ_1" -> "STATE_READ_2" [label="!start_bit && !stop_bit && scl_negedge && !(bit_count_reg >…"];
  "STATE_READ_2" -> "STATE_READ_3" [label="!start_bit && !stop_bit && scl_negedge"];
  "STATE_READ_3" -> "STATE_IDLE" [label="!start_bit && !stop_bit && scl_posedge && sda_i_reg"];
  "STATE_READ_3" -> "STATE_READ_1" [label="!start_bit && !stop_bit && scl_posedge && !sda_i_reg"];
}