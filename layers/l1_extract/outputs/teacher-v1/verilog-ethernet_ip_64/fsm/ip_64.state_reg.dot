digraph "ip_64.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="ip_64.state_reg (two-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_ARP_QUERY" [label="STATE_ARP_QUERY"];
  "STATE_WAIT_PACKET" [label="STATE_WAIT_PACKET"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_ARP_QUERY" [label="s_ip_hdr_valid"];
  "STATE_ARP_QUERY" -> "STATE_WAIT_PACKET" [label="arp_response_valid && arp_response_error |\narp_response_valid && !arp_response_error"];
  "STATE_WAIT_PACKET" -> "STATE_IDLE" [label="s_ip_payload_axis_tlast && s_ip_payload_axis_tready && s_ip…"];
}