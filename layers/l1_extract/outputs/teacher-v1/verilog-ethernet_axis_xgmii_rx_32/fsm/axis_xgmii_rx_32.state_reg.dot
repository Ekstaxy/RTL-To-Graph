digraph "axis_xgmii_rx_32.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_xgmii_rx_32.state_reg (two-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_PREAMBLE" [label="STATE_PREAMBLE"];
  "STATE_PAYLOAD" [label="STATE_PAYLOAD"];
  "STATE_LAST" [label="STATE_LAST"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_PREAMBLE" [label="xgmii_start_d2 && cfg_rx_enable && !framing_error_reg"];
  "STATE_PREAMBLE" -> "STATE_PAYLOAD" [label=""];
  "STATE_PAYLOAD" -> "STATE_IDLE" [label="framing_error_reg |\n!framing_error_reg && term_present_reg && term_lane_reg == 0"];
  "STATE_PAYLOAD" -> "STATE_LAST" [label="!framing_error_reg && term_present_reg && !(term_lane_reg =…"];
  "STATE_LAST" -> "STATE_IDLE" [label=""];
  __outs [shape=note, fontsize=9, label="outputs: last_cycle(moore), start_packet_next(moore)"];
}