stateDiagram-v2
    [*] --> STATE_IDLE
    ANY_STATE --> STATE_IDLE
    STATE_IDLE --> STATE_IDLE : xgmii_start_d2 && cfg_rx_enable && framing_error_reg
    STATE_IDLE --> STATE_PREAMBLE : xgmii_start_d2 && cfg_rx_enable && !framing_error_reg
    STATE_IDLE --> STATE_IDLE : !(xgmii_start_d2 && cfg_rx_enable)
    STATE_PREAMBLE --> STATE_PAYLOAD
    STATE_PAYLOAD --> STATE_IDLE : framing_error_reg
    STATE_PAYLOAD --> STATE_IDLE : !framing_error_reg && term_present_reg && term_lane_reg == 0
    STATE_PAYLOAD --> STATE_LAST : !framing_error_reg && term_present_reg && !(term_lane_reg == 0)
    STATE_PAYLOAD --> STATE_PAYLOAD : !framing_error_reg && !term_present_reg
    STATE_LAST --> STATE_IDLE
