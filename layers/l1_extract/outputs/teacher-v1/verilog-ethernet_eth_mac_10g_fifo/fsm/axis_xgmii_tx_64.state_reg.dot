digraph "axis_xgmii_tx_64.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_xgmii_tx_64.state_reg (two-process, 7 states)";
  "STATE_IDLE" [label="STATE_IDLE"];
  "STATE_PAYLOAD" [label="STATE_PAYLOAD"];
  "STATE_PAD" [label="STATE_PAD"];
  "STATE_ERR" [label="STATE_ERR"];
  "STATE_FCS_1" [label="STATE_FCS_1"];
  "STATE_FCS_2" [label="STATE_FCS_2"];
  "STATE_IFG" [label="STATE_IFG"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_PAYLOAD" [label="s_axis_tvalid && s_axis_tready"];
  "STATE_PAYLOAD" -> "STATE_PAD" [label="(!s_axis_tvalid || s_axis_tlast) && frame_min_count_reg && …"];
  "STATE_PAYLOAD" -> "STATE_ERR" [label="(!s_axis_tvalid || s_axis_tlast) && frame_min_count_reg && … |\n(!s_axis_tvalid || s_axis_tlast) && !frame_min_count_reg &&…"];
  "STATE_PAYLOAD" -> "STATE_FCS_1" [label="(!s_axis_tvalid || s_axis_tlast) && frame_min_count_reg && … |\n(!s_axis_tvalid || s_axis_tlast) && !frame_min_count_reg &&…"];
  "STATE_PAD" -> "STATE_ERR" [label="!(frame_min_count_reg > CTRL_WIDTH) && frame_error_reg"];
  "STATE_PAD" -> "STATE_FCS_1" [label="!(frame_min_count_reg > CTRL_WIDTH) && !frame_error_reg"];
  "STATE_FCS_1" -> "STATE_FCS_2" [label="s_empty_reg <= 4"];
  "STATE_FCS_1" -> "STATE_IFG" [label="!(s_empty_reg <= 4)"];
  "STATE_FCS_2" -> "STATE_IFG" [label="ifg_count_next > 8'd7"];
  "STATE_FCS_2" -> "STATE_IDLE" [label="!(ifg_count_next > 8'd7)"];
  "STATE_ERR" -> "STATE_IFG" [label=""];
  "STATE_IFG" -> "STATE_IDLE" [label="!(ifg_count_next > 8'd7 || frame_reg)"];
  __outs [shape=note, fontsize=9, label="outputs: reset_crc(moore), update_crc(moore)"];
}