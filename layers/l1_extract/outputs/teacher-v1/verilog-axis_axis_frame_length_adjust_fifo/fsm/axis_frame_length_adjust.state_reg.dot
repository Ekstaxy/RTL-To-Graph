digraph "axis_frame_length_adjust.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_frame_length_adjust.state_reg (two-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_TRUNCATE" [label="STATE_TRUNCATE"];
  "STATE_PAD" [label="STATE_PAD"];
  "STATE_TRANSFER" [label="STATE_TRANSFER"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_TRUNCATE" [label="s_axis_tready && s_axis_tvalid && long_counter_reg <= word_…"];
  "STATE_IDLE" -> "STATE_PAD" [label="s_axis_tready && s_axis_tvalid && !(long_counter_reg <= wor…"];
  "STATE_IDLE" -> "STATE_TRANSFER" [label="s_axis_tready && s_axis_tvalid && !(long_counter_reg <= wor…"];
  "STATE_TRANSFER" -> "STATE_IDLE" [label="s_axis_tready && s_axis_tvalid && long_counter_reg <= word_… |\ns_axis_tready && s_axis_tvalid && !(long_counter_reg <= wor… |\ns_axis_tready && s_axis_tvalid && !(long_counter_reg <= wor…"];
  "STATE_TRANSFER" -> "STATE_TRUNCATE" [label="s_axis_tready && s_axis_tvalid && long_counter_reg <= word_…"];
  "STATE_TRANSFER" -> "STATE_PAD" [label="s_axis_tready && s_axis_tvalid && !(long_counter_reg <= wor…"];
  "STATE_PAD" -> "STATE_IDLE" [label="m_axis_tready_int_reg && short_counter_reg <= KEEP_WIDTH"];
  "STATE_TRUNCATE" -> "STATE_IDLE" [label="s_axis_tready && s_axis_tvalid && s_axis_tlast"];
}