digraph "axivdisplay.phantom_start" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axivdisplay.phantom_start (two-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "0" [label="reset"];
  "1" [label="1"];
  "0" [peripheries=2, label="0"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "1" [label="", style=dashed, color="#e76f51"];
  "__any" -> "0" [label="no_fifo_space_available |\n(phantom_start || lag_start) |\nM_AXI_ARVALID && !M_AXI_ARREADY |\n(+1 more)", style=dashed, color="#e76f51"];
}