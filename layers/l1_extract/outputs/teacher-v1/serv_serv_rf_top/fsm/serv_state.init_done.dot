digraph "serv_state.init_done" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="serv_state.init_done (one-process, 1 states)";
  "0" [label="0"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "0" [label="i_rst", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: o_bufreg_en(mealy), o_dbus_cyc(mealy), o_init(mealy), o_mdu_valid(mealy), o_rf_wreq(mealy)"];
}