digraph "verified_fsm.ST_cr" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="verified_fsm.ST_cr (two-process, 6 states)";
  __reset [shape=point, width=0.15];
  __reset -> "s0" [label="reset"];
  "s0" [peripheries=2, label="s0"];
  "s1" [label="s1"];
  "s2" [label="s2"];
  "s3" [label="s3"];
  "s4" [label="s4"];
  "s5" [label="s5"];
  "s0" -> "s1" [label="!(IN==0)"];
  "s1" -> "s2" [label="IN==0"];
  "s2" -> "s3" [label="IN==0"];
  "s2" -> "s1" [label="!(IN==0)"];
  "s3" -> "s0" [label="IN==0"];
  "s3" -> "s4" [label="!(IN==0)"];
  "s4" -> "s2" [label="IN==0"];
  "s4" -> "s5" [label="!(IN==0)"];
  "s5" -> "s2" [label="IN==0"];
  "s5" -> "s1" [label="!(IN==0)"];
  __outs [shape=note, fontsize=9, label="outputs: MATCH(mealy)"];
}