digraph "picorv32.mem_state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="picorv32.mem_state (one-process, 4 states)";
  "0" [label="0"];
  "1" [label="1"];
  "2" [label="2"];
  "3" [label="3"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "0" [label="(!resetn || trap) && !resetn", style=dashed, color="#e76f51"];
  "0" -> "1" [label="!(!resetn || trap) && ((mem_do_prefetch || mem_do_rinst) ||…"];
  "0" -> "2" [label="!(!resetn || trap) && mem_do_wdata"];
  "1" -> "0" [label="!(!resetn || trap) && mem_xfer && (mem_do_rinst || mem_do_r…"];
  "1" -> "3" [label="!(!resetn || trap) && mem_xfer && !(mem_do_rinst || mem_do_…"];
  "2" -> "0" [label="!(!resetn || trap) && mem_xfer"];
  "3" -> "0" [label="!(!resetn || trap) && mem_do_rinst"];
  __outs [shape=note, fontsize=9, label="outputs: mem_instr(moore), mem_la_read(mealy), mem_la_write(mealy), mem_valid(moore), mem_wstrb(moore)"];
}