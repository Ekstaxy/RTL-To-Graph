digraph "picorv32_wb.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="picorv32_wb.state (one-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "IDLE" [label="reset"];
  "IDLE" [peripheries=2, label="IDLE"];
  "WBSTART" [label="WBSTART"];
  "WBEND" [label="WBEND"];
  "IDLE" -> "WBSTART" [label="mem_valid"];
  "WBSTART" -> "WBEND" [label="wbm_ack_i"];
  "WBEND" -> "IDLE" [label=""];
  __outs [shape=note, fontsize=9, label="outputs: wbm_adr_o(moore), wbm_cyc_o(moore), wbm_dat_o(moore), wbm_sel_o(moore), wbm_stb_o(moore), wbm_we_o(moore)"];
}