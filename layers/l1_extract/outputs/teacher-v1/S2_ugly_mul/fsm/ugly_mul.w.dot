digraph "ugly_mul.w" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="ugly_mul.w (one-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "1" [label="reset"];
  "1" [peripheries=2, label="1"];
  "2" [label="2"];
  "4" [label="4"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "2" [label="hot_i && s |\n!hot_i && hot_r && !ends", style=dashed, color="#e76f51"];
  "__any" -> "1" [label="hot_i && !s |\n!hot_i && !hot_r", style=dashed, color="#e76f51"];
  "__any" -> "4" [label="!hot_i && hot_r && ends", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: hot_f(moore), hot_i(moore), hot_r(moore)"];
}