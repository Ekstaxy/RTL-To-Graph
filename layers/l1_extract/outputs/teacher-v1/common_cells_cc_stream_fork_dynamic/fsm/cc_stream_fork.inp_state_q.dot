digraph "cc_stream_fork.inp_state_q" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="cc_stream_fork.inp_state_q (two-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "READY" [label="reset"];
  "READY" [peripheries=2, label="READY"];
  "WAIT" [label="WAIT"];
  "READY" -> "WAIT" [label="valid_i && !(valid_o == all_ones && ready_i == all_ones)"];
  "WAIT" -> "READY" [label="valid_i && oup_ready == all_ones"];
  __outs [shape=note, fontsize=9, label="outputs: ready_o(mealy)"];
}