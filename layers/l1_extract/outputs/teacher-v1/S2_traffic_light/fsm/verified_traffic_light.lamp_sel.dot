digraph "verified_traffic_light.lamp_sel" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="verified_traffic_light.lamp_sel (two-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "PH_OFF" [label="reset"];
  "PH_STOP" [label="PH_STOP"];
  "PH_GO" [label="PH_GO"];
  "PH_WARN" [label="PH_WARN"];
  "PH_OFF" [peripheries=2, label="PH_OFF"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "PH_STOP" [label="lamp_sel[3] |\n!lamp_sel[3] && !(lamp_sel[2] && expired) && lamp_sel[1] &&…", style=dashed, color="#e76f51"];
  "__any" -> "PH_GO" [label="!lamp_sel[3] && lamp_sel[2] && expired", style=dashed, color="#e76f51"];
  "__any" -> "PH_WARN" [label="!lamp_sel[3] && !(lamp_sel[2] && expired) && !(lamp_sel[1] …", style=dashed, color="#e76f51"];
}