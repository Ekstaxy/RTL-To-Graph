digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (two-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "WL" [label="reset"];
  "WL" [peripheries=2, label="WL"];
  "WR" [label="WR"];
  "FALLL" [label="FALLL"];
  "FALLR" [label="FALLR"];
  "WL" -> "WR" [label="ground && bump_left"];
  "WL" -> "FALLL" [label="!ground"];
  "WR" -> "WL" [label="ground && bump_right"];
  "WR" -> "FALLR" [label="!ground"];
  "FALLL" -> "WL" [label="ground"];
  "FALLR" -> "WR" [label="ground"];
  __outs [shape=note, fontsize=9, label="outputs: aaah(moore), walk_left(moore), walk_right(moore)"];
}