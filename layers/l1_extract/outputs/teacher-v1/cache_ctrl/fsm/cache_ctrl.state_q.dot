digraph "cache_ctrl.state_q" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="cache_ctrl.state_q (two-process, 5 states)";
  __reset [shape=point, width=0.15];
  __reset -> "IDLE" [label="reset"];
  "IDLE" [peripheries=2, label="IDLE"];
  "LOOKUP" [label="LOOKUP"];
  "WRITE_MEM" [label="WRITE_MEM"];
  "REFILL" [label="REFILL"];
  "RESPOND" [label="RESPOND"];
  "IDLE" -> "LOOKUP" [label="cpu_req_valid"];
  "LOOKUP" -> "WRITE_MEM" [label="we_q"];
  "LOOKUP" -> "RESPOND" [label="!we_q && hit"];
  "LOOKUP" -> "REFILL" [label="!we_q && !hit"];
  "WRITE_MEM" -> "RESPOND" [label="mem_ack"];
  "REFILL" -> "RESPOND" [label="mem_ack"];
  "RESPOND" -> "IDLE" [label=""];
  __outs [shape=note, fontsize=9, label="outputs: cpu_req_ready(moore), cpu_resp_valid(moore), mem_req(moore), mem_we(moore), stall_o(moore)"];
}