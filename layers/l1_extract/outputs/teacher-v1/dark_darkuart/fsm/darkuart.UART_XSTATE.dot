digraph "darkuart.UART_XSTATE" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="darkuart.UART_XSTATE (one-process, 1 states)";
  "6" [label="6"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "6" [label="(RES||UART_XSTATE==1)", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: DEBUG(mealy), TXD(moore)"];
}