digraph "sequence_detector.pos" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="sequence_detector.pos (one-process, 5 states)";
  __reset [shape=point, width=0.15];
  __reset -> "5" [label="reset"];
  "5" [peripheries=2, label="5"];
  "2" [label="2"];
  "3" [label="3"];
  "6" [label="6"];
  "0" [label="0"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "2" [label="pos == 3'b000 && b", style=dashed, color="#e76f51"];
  "__any" -> "3" [label="!(pos == 3'b000 && b) && b", style=dashed, color="#e76f51"];
  "__any" -> "6" [label="!(pos == 3'b000 && b) && !b && (pos == 3'b011 || on_e)", style=dashed, color="#e76f51"];
  "6" -> "0" [label="!(pos == 3'b000 && b) && !b && !(pos == 3'b011 || on_e)"];
  "__any" -> "5" [label="!(pos == 3'b000 && b) && !b && !(pos == 3'b011 || on_e) && …", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: on_e(moore)"];
}