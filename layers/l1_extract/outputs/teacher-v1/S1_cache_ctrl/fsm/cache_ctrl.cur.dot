digraph "cache_ctrl.cur" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="cache_ctrl.cur (one-process, 5 states)";
  __reset [shape=point, width=0.15];
  __reset -> "HOME" [label="reset"];
  "HOME" [peripheries=2, label="HOME"];
  "PROBE" [label="PROBE"];
  "PUSH" [label="PUSH"];
  "ACK" [label="ACK"];
  "PULL" [label="PULL"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "PROBE" [label="at_home && cpu_req_valid", style=dashed, color="#e76f51"];
  "__any" -> "PUSH" [label="!at_home && at_probe && lat_w", style=dashed, color="#e76f51"];
  "__any" -> "ACK" [label="!at_home && at_probe && !lat_w && match |\n!at_home && !at_probe && (at_push || at_pull) && mem_ack", style=dashed, color="#e76f51"];
  "__any" -> "PULL" [label="!at_home && at_probe && !lat_w && !match", style=dashed, color="#e76f51"];
  "__any" -> "HOME" [label="!at_home && !at_probe && !(at_push || at_pull)", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: at_ack(moore), at_home(moore), at_probe(moore), at_pull(moore), at_push(moore)"];
}