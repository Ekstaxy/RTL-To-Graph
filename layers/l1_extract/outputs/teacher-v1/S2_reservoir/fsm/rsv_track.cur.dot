digraph "rsv_track.cur" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="rsv_track.cur (two-process, 6 states)";
  __reset [shape=point, width=0.15];
  __reset -> "Z_BOT" [label="reset"];
  "Z_BOT" [peripheries=2, label="Z_BOT"];
  "Z_1U" [label="Z_1U"];
  "Z_2U" [label="Z_2U"];
  "Z_TOP" [label="Z_TOP"];
  "Z_1D" [label="Z_1D"];
  "Z_2D" [label="Z_2D"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "Z_BOT" -> "Z_1U" [label="lv[0]"];
  "__any" -> "Z_2U" [label="!(cur == Z_BOT) && (cur == Z_1U || cur == Z_1D) && lv[1]", style=dashed, color="#e76f51"];
  "__any" -> "Z_BOT" [label="!(cur == Z_BOT) && (cur == Z_1U || cur == Z_1D) && !lv[1] &…", style=dashed, color="#e76f51"];
  "__any" -> "Z_TOP" [label="!(cur == Z_BOT) && !(cur == Z_1U || cur == Z_1D) && (cur ==…", style=dashed, color="#e76f51"];
  "__any" -> "Z_1D" [label="!(cur == Z_BOT) && !(cur == Z_1U || cur == Z_1D) && (cur ==…", style=dashed, color="#e76f51"];
  "Z_TOP" -> "Z_2D" [label="!(cur == Z_BOT) && !(cur == Z_1U || cur == Z_1D) && !(cur =…"];
}