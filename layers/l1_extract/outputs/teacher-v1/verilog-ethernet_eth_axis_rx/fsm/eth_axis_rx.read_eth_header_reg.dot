  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "0" [label="(s_axis_tready && s_axis_tvalid || m_eth_payload_axis_tread…", style=dashed, color="#e76f51"];
  "__any" -> "1" [label="(s_axis_tready && s_axis_tvalid || m_eth_payload_axis_tread…", style=dashed, color="#e76f51"];
}