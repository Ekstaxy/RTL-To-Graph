digraph "verified_traffic_light.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="verified_traffic_light.state (one-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "idle" [label="reset"];
  "idle" [peripheries=2, label="idle"];
  "s1_red" [label="s1_red"];
  "s3_green" [label="s3_green"];
  "s2_yellow" [label="s2_yellow"];
  "idle" -> "s1_red" [label=""];
  "s1_red" -> "s3_green" [label="cnt == 3"];
  "s2_yellow" -> "s1_red" [label="cnt == 3"];
  "s3_green" -> "s2_yellow" [label="cnt == 3"];
}