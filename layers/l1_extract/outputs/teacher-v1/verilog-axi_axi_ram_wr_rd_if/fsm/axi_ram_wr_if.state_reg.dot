digraph "axi_ram_wr_if.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axi_ram_wr_if.state_reg (two-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_BURST" [label="STATE_BURST"];
  "STATE_RESP" [label="STATE_RESP"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_BURST" [label="s_axi_awready && s_axi_awvalid"];
  "STATE_BURST" -> "STATE_IDLE" [label="s_axi_wready && s_axi_wvalid && !(write_count_reg > 0) && (…"];
  "STATE_BURST" -> "STATE_RESP" [label="s_axi_wready && s_axi_wvalid && !(write_count_reg > 0) && !…"];
  "STATE_RESP" -> "STATE_IDLE" [label="(s_axi_bready || !s_axi_bvalid)"];
}