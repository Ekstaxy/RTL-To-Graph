digraph "axi_dma_rd.axi_state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axi_dma_rd.axi_state_reg (two-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "AXI_STATE_IDLE" [label="reset"];
  "AXI_STATE_IDLE" [peripheries=2, label="AXI_STATE_IDLE"];
  "AXI_STATE_START" [label="AXI_STATE_START"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "AXI_STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "AXI_STATE_IDLE" -> "AXI_STATE_START" [label="s_axis_read_desc_ready && s_axis_read_desc_valid"];
  "AXI_STATE_START" -> "AXI_STATE_IDLE" [label="!m_axi_arvalid && !(op_word_count_next > 0)"];
}