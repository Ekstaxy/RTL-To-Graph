  "__any" -> "0" [label="current_s_tvalid & current_s_tready && current_s_tlast", style=dashed, color="#e76f51"];
  "__any" -> "1" [label="!frame_reg && enable && !m_eth_hdr_valid && (s_eth_hdr_vali…", style=dashed, color="#e76f51"];
}