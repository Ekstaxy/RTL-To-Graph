digraph "uart_tx.ph" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="uart_tx.ph (one-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "PH_REST" [label="reset"];
  "PH_REST" [peripheries=2, label="PH_REST"];
  "PH_LEAD" [label="PH_LEAD"];
  "PH_PAY" [label="PH_PAY"];
  "PH_TAIL" [label="PH_TAIL"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "PH_LEAD" [label="ph[0] && tx_valid", style=dashed, color="#e76f51"];
  "__any" -> "PH_PAY" [label="!ph[0] && ph[1] && wrap", style=dashed, color="#e76f51"];
  "__any" -> "PH_TAIL" [label="!ph[0] && !ph[1] && ph[2] && wrap && (&nb)", style=dashed, color="#e76f51"];
  "__any" -> "PH_REST" [label="!ph[0] && !ph[1] && !ph[2] && wrap", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: busy_o(moore), tx_o(moore), quiet(moore)"];
}