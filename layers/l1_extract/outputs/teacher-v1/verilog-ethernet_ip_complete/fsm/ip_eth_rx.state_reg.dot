digraph "ip_eth_rx.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="ip_eth_rx.state_reg (two-process, 5 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_READ_HEADER" [label="STATE_READ_HEADER"];
  "STATE_WAIT_LAST" [label="STATE_WAIT_LAST"];
  "STATE_READ_PAYLOAD" [label="STATE_READ_PAYLOAD"];
  "STATE_READ_PAYLOAD_LAST" [label="STATE_READ_PAYLOAD_LAST"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_READ_HEADER" [label="s_eth_hdr_ready && s_eth_hdr_valid"];
  "STATE_READ_HEADER" -> "STATE_WAIT_LAST" [label="s_eth_payload_axis_tready && s_eth_payload_axis_tvalid && h… |\ns_eth_payload_axis_tready && s_eth_payload_axis_tvalid && h…"];
  "STATE_READ_HEADER" -> "STATE_READ_PAYLOAD" [label="s_eth_payload_axis_tready && s_eth_payload_axis_tvalid && h…"];
  "STATE_READ_HEADER" -> "STATE_IDLE" [label="s_eth_payload_axis_tready && s_eth_payload_axis_tvalid && s…"];
  "STATE_READ_PAYLOAD" -> "STATE_IDLE" [label="s_eth_payload_axis_tready && s_eth_payload_axis_tvalid && s…"];
  "STATE_READ_PAYLOAD" -> "STATE_READ_PAYLOAD_LAST" [label="s_eth_payload_axis_tready && s_eth_payload_axis_tvalid && !…"];
  "STATE_READ_PAYLOAD_LAST" -> "STATE_IDLE" [label="s_eth_payload_axis_tready && s_eth_payload_axis_tvalid && s…"];
  "STATE_WAIT_LAST" -> "STATE_IDLE" [label="s_eth_payload_axis_tready && s_eth_payload_axis_tvalid && s…"];
}