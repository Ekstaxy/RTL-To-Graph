digraph "verified_traffic_light.lamp" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="verified_traffic_light.lamp (two-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "BOOT" [label="reset"];
  "BOOT" [peripheries=2, label="BOOT"];
  "STOP" [label="STOP"];
  "GO" [label="GO"];
  "SLOW" [label="SLOW"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "BOOT" -> "STOP" [label=""];
  "STOP" -> "GO" [label="!(lamp == BOOT) && hit3"];
  "GO" -> "SLOW" [label="!(lamp == BOOT) && hit3 && !(lamp == STOP)"];
  "__any" -> "STOP" [label="!(lamp == BOOT) && hit3 && !(lamp == STOP) && !(lamp == GO)", style=dashed, color="#e76f51"];
}