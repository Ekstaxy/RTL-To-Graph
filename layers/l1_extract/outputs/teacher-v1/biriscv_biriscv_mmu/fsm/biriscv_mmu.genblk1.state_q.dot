digraph "biriscv_mmu.genblk1.state_q" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="biriscv_mmu.genblk1.state_q (one-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_LEVEL_FIRST" [label="STATE_LEVEL_FIRST"];
  "STATE_UPDATE" [label="STATE_UPDATE"];
  "STATE_LEVEL_SECOND" [label="STATE_LEVEL_SECOND"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_LEVEL_FIRST" [label="state_q == STATE_IDLE && (itlb_miss_w || dtlb_miss_w)", style=dashed, color="#e76f51"];
  "__any" -> "STATE_UPDATE" [label="!(state_q == STATE_IDLE && (itlb_miss_w || dtlb_miss_w)) &&… |\n!(state_q == STATE_IDLE && (itlb_miss_w || dtlb_miss_w)) &&… |\n!(state_q == STATE_IDLE && (itlb_miss_w || dtlb_miss_w)) &&… |\n(+1 more)", style=dashed, color="#e76f51"];
  "__any" -> "STATE_LEVEL_SECOND" [label="!(state_q == STATE_IDLE && (itlb_miss_w || dtlb_miss_w)) &&…", style=dashed, color="#e76f51"];
  "STATE_UPDATE" -> "STATE_IDLE" [label="!(state_q == STATE_IDLE && (itlb_miss_w || dtlb_miss_w)) &&…"];
  __outs [shape=note, fontsize=9, label="outputs: idle_w(moore)"];
}