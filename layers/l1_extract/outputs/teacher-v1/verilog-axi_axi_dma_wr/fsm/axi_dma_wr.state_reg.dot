digraph "axi_dma_wr.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axi_dma_wr.state_reg (two-process, 5 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_START" [label="STATE_START"];
  "STATE_WRITE" [label="STATE_WRITE"];
  "STATE_FINISH_BURST" [label="STATE_FINISH_BURST"];
  "STATE_DROP_DATA" [label="STATE_DROP_DATA"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_START" [label="s_axis_write_desc_ready && s_axis_write_desc_valid"];
  "STATE_START" -> "STATE_WRITE" [label="!m_axi_awvalid_reg && active_count_av_reg && m_axi_awvalid_…"];
  "STATE_WRITE" -> "STATE_IDLE" [label="((s_axis_write_data_tready && shift_axis_tvalid || !input_a…"];
  "STATE_WRITE" -> "STATE_FINISH_BURST" [label="((s_axis_write_data_tready && shift_axis_tvalid || !input_a…"];
  "STATE_WRITE" -> "STATE_START" [label="((s_axis_write_data_tready && shift_axis_tvalid || !input_a…"];
  "STATE_WRITE" -> "STATE_DROP_DATA" [label="((s_axis_write_data_tready && shift_axis_tvalid || !input_a…"];
  "STATE_FINISH_BURST" -> "STATE_IDLE" [label="m_axi_wready_int && output_last_cycle_reg"];
  "STATE_DROP_DATA" -> "STATE_IDLE" [label="shift_axis_tvalid && shift_axis_tlast"];
  __outs [shape=note, fontsize=9, label="outputs: flush_save(moore)"];
}