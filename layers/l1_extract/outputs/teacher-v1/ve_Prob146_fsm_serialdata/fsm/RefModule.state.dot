digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (two-process, 12 states)";
  __reset [shape=point, width=0.15];
  __reset -> "START" [label="reset"];
  "START" [peripheries=2, label="START"];
  "B0" [label="B0"];
  "B1" [label="B1"];
  "B2" [label="B2"];
  "B3" [label="B3"];
  "B4" [label="B4"];
  "B5" [label="B5"];
  "B6" [label="B6"];
  "B7" [label="B7"];
  "STOP" [label="STOP"];
  "DONE" [label="DONE"];
  "ERR" [label="ERR"];
  "START" -> "B0" [label="!in"];
  "B0" -> "B1" [label=""];
  "B1" -> "B2" [label=""];
  "B2" -> "B3" [label=""];
  "B3" -> "B4" [label=""];
  "B4" -> "B5" [label=""];
  "B5" -> "B6" [label=""];
  "B6" -> "B7" [label=""];
  "B7" -> "STOP" [label=""];
  "STOP" -> "DONE" [label="in"];
  "STOP" -> "ERR" [label="!in"];
  "DONE" -> "START" [label="in"];
  "DONE" -> "B0" [label="!in"];
  "ERR" -> "START" [label="in"];
  __outs [shape=note, fontsize=9, label="outputs: done(moore)"];
}