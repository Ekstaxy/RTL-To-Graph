digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (two-process, 5 states)";
  __reset [shape=point, width=0.15];
  __reset -> "S" [label="reset"];
  "S" [peripheries=2, label="S"];
  "S1" [label="S1"];
  "S11" [label="S11"];
  "S110" [label="S110"];
  "Done" [label="Done"];
  "S" -> "S1" [label="data"];
  "S1" -> "S11" [label="data"];
  "S1" -> "S" [label="!data"];
  "S11" -> "S110" [label="!data"];
  "S110" -> "Done" [label="data"];
  "S110" -> "S" [label="!data"];
  __outs [shape=note, fontsize=9, label="outputs: start_shifting(moore)"];
}