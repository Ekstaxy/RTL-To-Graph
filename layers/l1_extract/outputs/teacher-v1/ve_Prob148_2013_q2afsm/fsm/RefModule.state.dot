digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (two-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "A" [label="reset"];
  "A" [peripheries=2, label="A"];
  "B" [label="B"];
  "C" [label="C"];
  "D" [label="D"];
  "A" -> "B" [label="r[0]"];
  "A" -> "C" [label="!r[0] && r[1]"];
  "A" -> "D" [label="!r[0] && !r[1] && r[2]"];
  "B" -> "A" [label="!r[0]"];
  "C" -> "A" [label="!r[1]"];
  "D" -> "A" [label="!r[2]"];
  __outs [shape=note, fontsize=9, label="outputs: g(moore)"];
}