digraph "uart_tx.state_q" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="uart_tx.state_q (two-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "S_IDLE" [label="reset"];
  "S_IDLE" [peripheries=2, label="S_IDLE"];
  "S_START" [label="S_START"];
  "S_DATA" [label="S_DATA"];
  "S_STOP" [label="S_STOP"];
  "S_IDLE" -> "S_START" [label="tx_valid"];
  "S_START" -> "S_DATA" [label="baud_tick"];
  "S_DATA" -> "S_STOP" [label="baud_tick && bit_idx_q == 3'd7"];
  "S_STOP" -> "S_IDLE" [label="baud_tick"];
  __outs [shape=note, fontsize=9, label="outputs: busy_o(moore), tx_o(moore), tx_ready(moore)"];
}