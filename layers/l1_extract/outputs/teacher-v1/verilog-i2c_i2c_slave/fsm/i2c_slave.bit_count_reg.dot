  "STATE_WRITE_1" -> "STATE_ACK" [label="<datapath condition>"];
  "S_4" -> "STATE_READ_3" [label="!sda_i_reg && scl_i_reg && last_sda_i_reg || <datapath cond…"];
  "S_4" -> "STATE_WRITE_1" [label="<datapath condition>"];
  "STATE_READ_1" -> "S_4" [label="<datapath condition>"];
  "STATE_READ_1" -> "STATE_READ_3" [label="!sda_i_reg && scl_i_reg && last_sda_i_reg || <datapath cond…"];
  "STATE_READ_2" -> "STATE_READ_1" [label="<datapath condition>"];
  "STATE_READ_2" -> "STATE_READ_3" [label="!sda_i_reg && scl_i_reg && last_sda_i_reg || <datapath cond…"];
