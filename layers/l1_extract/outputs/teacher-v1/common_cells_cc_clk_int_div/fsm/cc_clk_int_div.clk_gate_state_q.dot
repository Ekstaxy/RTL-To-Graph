digraph "cc_clk_int_div.clk_gate_state_q" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="cc_clk_int_div.clk_gate_state_q (two-process, 3 states)";
  __reset [shape=point, width=0.15];
  __reset -> "IDLE" [label="reset"];
  "IDLE" [peripheries=2, label="IDLE"];
  "LOAD_DIV" [label="LOAD_DIV"];
  "WAIT_END_PERIOD" [label="WAIT_END_PERIOD"];
  "IDLE" -> "LOAD_DIV" [label="div_valid_i && !(div_i_normalized == div_q)"];
  "LOAD_DIV" -> "WAIT_END_PERIOD" [label="((gate_is_open_q == 1'b0) || clk_div_bypass_en_q)"];
  "WAIT_END_PERIOD" -> "IDLE" [label="cycle_cntr_q == div_q - 1"];
  __outs [shape=note, fontsize=9, label="outputs: div_ready_o(mealy)"];
}