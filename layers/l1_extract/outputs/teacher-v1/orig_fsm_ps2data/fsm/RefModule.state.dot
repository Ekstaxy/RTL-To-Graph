digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (two-process, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "BYTE1" [label="reset"];
  "BYTE1" [peripheries=2, label="BYTE1"];
  "BYTE2" [label="BYTE2"];
  "BYTE3" [label="BYTE3"];
  "DONE" [label="DONE"];
  "BYTE1" -> "BYTE2" [label="in3"];
  "BYTE2" -> "BYTE3" [label=""];
  "BYTE3" -> "DONE" [label=""];
  "DONE" -> "BYTE2" [label="in3"];
  "DONE" -> "BYTE1" [label="!in3"];
  __outs [shape=note, fontsize=9, label="outputs: done(moore)"];
}