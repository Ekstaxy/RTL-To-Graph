digraph "RefModule.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.state (one-process, 10 states)";
  __reset [shape=point, width=0.15];
  __reset -> "S0" [label="reset"];
  "S0" [peripheries=2, label="S0"];
  "S1" [label="S1"];
  "S2" [label="S2"];
  "S3" [label="S3"];
  "S4" [label="S4"];
  "S5" [label="S5"];
  "S6" [label="S6"];
  "SDISC" [label="SDISC"];
  "SERR" [label="SERR"];
  "SFLAG" [label="SFLAG"];
  "S0" -> "S1" [label="in"];
  "S1" -> "S2" [label="in"];
  "S1" -> "S0" [label="!in"];
  "S2" -> "S3" [label="in"];
  "S2" -> "S0" [label="!in"];
  "S3" -> "S4" [label="in"];
  "S3" -> "S0" [label="!in"];
  "S4" -> "S5" [label="in"];
  "S4" -> "S0" [label="!in"];
  "S5" -> "S6" [label="in"];
  "S5" -> "SDISC" [label="!in"];
  "S6" -> "SERR" [label="in"];
  "S6" -> "SFLAG" [label="!in"];
  "SERR" -> "S0" [label="!in"];
  "SFLAG" -> "S1" [label="in"];
  "SFLAG" -> "S0" [label="!in"];
  "SDISC" -> "S1" [label="in"];
  "SDISC" -> "S0" [label="!in"];
  __outs [shape=note, fontsize=9, label="outputs: disc(moore), err(moore), flag(moore)"];
}