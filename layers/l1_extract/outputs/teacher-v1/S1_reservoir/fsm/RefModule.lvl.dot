digraph "RefModule.lvl" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="RefModule.lvl (one-process, 1 states)";
  "LV_EMPTY" [label="LV_EMPTY"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "LV_EMPTY" [label="reset", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: dfr(moore), fr0(moore), fr2(moore), bot(moore), low_pair(moore), up_band(moore)"];
}