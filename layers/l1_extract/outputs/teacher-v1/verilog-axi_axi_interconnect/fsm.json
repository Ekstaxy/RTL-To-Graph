   },
   {
    "src": "STATE_WRITE_DROP",
    "dst": "STATE_WAIT_IDLE",
    "cond": "current_s_axi_wready && current_s_axi_wvalid && current_s_axi_wlast"
   },
   {
    "src": "STATE_WRITE_DROP",
    "dst": "STATE_WRITE_DROP",
    "cond": "!(current_s_axi_wready && current_s_axi_wvalid && current_s_axi_wlast)"
   },
   {
    "src": "STATE_READ",
    "dst": "STATE_WAIT_IDLE",
    "cond": "current_m_axi_rready && current_m_axi_rvalid && current_m_axi_rlast"
   },
   {
    "src": "STATE_READ",
