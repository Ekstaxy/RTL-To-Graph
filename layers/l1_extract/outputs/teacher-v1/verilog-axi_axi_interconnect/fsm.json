   },
   {
    "src": "STATE_READ_DROP",
    "dst": "STATE_WAIT_IDLE",
    "cond": "s_axi_rready_int_reg && axi_len_reg == 0"
   },
   {
    "src": "STATE_READ_DROP",
    "dst": "STATE_READ_DROP",
    "cond": "s_axi_rready_int_reg && !(axi_len_reg == 0)"
   },
   {
    "src": "STATE_READ_DROP",
    "dst": "STATE_READ_DROP",
