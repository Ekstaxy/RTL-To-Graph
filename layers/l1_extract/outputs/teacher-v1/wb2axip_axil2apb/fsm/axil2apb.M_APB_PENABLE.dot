digraph "axil2apb.M_APB_PENABLE" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axil2apb.M_APB_PENABLE (one-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "0" [label="reset"];
  "0" [peripheries=2, label="0"];
  "1" [label="1"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "0" [label="apb_idle |\n!apb_idle && M_APB_PENABLE && M_APB_PREADY", style=dashed, color="#e76f51"];
  "__any" -> "1" [label="!apb_idle && !M_APB_PENABLE", style=dashed, color="#e76f51"];
  __outs [shape=note, fontsize=9, label="outputs: M_APB_PSEL(moore)"];
}