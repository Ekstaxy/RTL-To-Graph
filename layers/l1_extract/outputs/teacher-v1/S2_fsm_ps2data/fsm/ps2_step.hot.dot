digraph "ps2_step.hot" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="ps2_step.hot (semantic, 4 states)";
  __reset [shape=point, width=0.15];
  __reset -> "H_SEEK" [label="reset"];
  "H_SEEK" [peripheries=2, label="H_SEEK"];
  "H_B2" [label="H_B2"];
  "H_B3" [label="H_B3"];
  "H_FIN" [label="H_FIN"];
  "H_SEEK" -> "H_B2" [label="<datapath condition>"];
  "H_B2" -> "H_B3" [label=""];
  "H_B3" -> "H_FIN" [label=""];
  "H_FIN" -> "H_SEEK" [label="<datapath condition>"];
  "H_FIN" -> "H_B2" [label="<datapath condition>"];
}