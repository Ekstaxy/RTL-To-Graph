digraph "arp.arp_request_operation_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="arp.arp_request_operation_reg (two-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "0" [label="reset"];
  "0" [peripheries=2, label="0"];
  "1" [label="1"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "0" [label="arp_request_operation_reg && cache_query_response_valid && … |\narp_request_operation_reg && arp_request_timer_reg == 0 && …", style=dashed, color="#e76f51"];
  "__any" -> "1" [label="!arp_request_operation_reg && cache_query_request_valid_reg…", style=dashed, color="#e76f51"];
}