[
 {
  "module": "axi_ram_rd_if",
  "instance": "axi_ram_rd_if",
  "state": "state_reg",
  "next": "state_next",
  "style": "two-process",
  "states": [
   {
    "name": "STATE_IDLE",
    "value": "1'b0"
   },
   {
    "name": "STATE_BURST",
    "value": "1'b1"
   }
  ],
  "reset_state": "STATE_IDLE",
  "transitions": [
   {
    "src": "*",
    "dst": "STATE_IDLE",
    "cond": "1"
   },
   {
    "src": "STATE_IDLE",
    "dst": "STATE_BURST",
    "cond": "s_axi_arready && s_axi_arvalid"
   },
   {
    "src": "STATE_IDLE",
    "dst": "STATE_IDLE",
    "cond": "!(s_axi_arready && s_axi_arvalid)"
   },
   {
    "src": "STATE_BURST",
    "dst": "STATE_BURST",
    "cond": "ram_rd_cmd_ready && ram_rd_cmd_en && read_count_reg > 0"
   },
   {
    "src": "STATE_BURST",
    "dst": "STATE_IDLE",
    "cond": "ram_rd_cmd_ready && ram_rd_cmd_en && !(read_count_reg > 0)"
   },
   {
    "src": "STATE_BURST",
    "dst": "STATE_BURST",
    "cond": "!(ram_rd_cmd_ready && ram_rd_cmd_en)"
   }
  ],
  "outputs": [],
  "warnings": [],
  "semantic_check": "consistent"
 }
]