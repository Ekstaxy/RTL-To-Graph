  "__any" -> "0" [label="(!S_AXI_ARESETN || clear_request) |\n!(!S_AXI_ARESETN || clear_request) && idle_bus && stop_requ…", style=dashed, color="#e76f51"];
  "__any" -> "1" [label="!(!S_AXI_ARESETN || clear_request) && idle_bus && start_req…", style=dashed, color="#e76f51"];
}