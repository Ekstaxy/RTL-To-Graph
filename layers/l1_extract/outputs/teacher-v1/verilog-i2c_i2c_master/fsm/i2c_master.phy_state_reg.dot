digraph "i2c_master.phy_state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="i2c_master.phy_state_reg (two-process, 16 states)";
  __reset [shape=point, width=0.15];
  __reset -> "PHY_STATE_IDLE" [label="reset"];
  "PHY_STATE_IDLE" [peripheries=2, label="PHY_STATE_IDLE"];
  "PHY_STATE_START_1" [label="PHY_STATE_START_1"];
  "PHY_STATE_ACTIVE" [label="PHY_STATE_ACTIVE"];
  "PHY_STATE_REPEATED_START_1" [label="PHY_STATE_REPEATED_START_1"];
  "PHY_STATE_WRITE_BIT_1" [label="PHY_STATE_WRITE_BIT_1"];
  "PHY_STATE_READ_BIT_1" [label="PHY_STATE_READ_BIT_1"];
  "PHY_STATE_STOP_1" [label="PHY_STATE_STOP_1"];
  "PHY_STATE_REPEATED_START_2" [label="PHY_STATE_REPEATED_START_2"];
  "PHY_STATE_START_2" [label="PHY_STATE_START_2"];
  "PHY_STATE_WRITE_BIT_2" [label="PHY_STATE_WRITE_BIT_2"];
  "PHY_STATE_WRITE_BIT_3" [label="PHY_STATE_WRITE_BIT_3"];
  "PHY_STATE_READ_BIT_2" [label="PHY_STATE_READ_BIT_2"];
