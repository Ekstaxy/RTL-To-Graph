digraph "i2c_master.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="i2c_master.state_reg (two-process, 12 states)";
  __reset [shape=point, width=0.15];
  __reset -> "STATE_IDLE" [label="reset"];
  "STATE_IDLE" [peripheries=2, label="STATE_IDLE"];
  "STATE_START_WAIT" [label="STATE_START_WAIT"];
  "STATE_ADDRESS_1" [label="STATE_ADDRESS_1"];
  "STATE_ACTIVE_WRITE" [label="STATE_ACTIVE_WRITE"];
  "STATE_WRITE_1" [label="STATE_WRITE_1"];
  "STATE_ACTIVE_READ" [label="STATE_ACTIVE_READ"];
  "STATE_START" [label="STATE_START"];
  "STATE_READ" [label="STATE_READ"];
  "STATE_STOP" [label="STATE_STOP"];
  "STATE_ADDRESS_2" [label="STATE_ADDRESS_2"];
  "STATE_WRITE_2" [label="STATE_WRITE_2"];
  "STATE_WRITE_3" [label="STATE_WRITE_3"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_START_WAIT" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_IDLE" -> "STATE_ADDRESS_1" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_ACTIVE_WRITE" -> "STATE_ADDRESS_1" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_ACTIVE_WRITE" -> "STATE_WRITE_1" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_ACTIVE_WRITE" -> "STATE_IDLE" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S… |\n!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_ACTIVE_READ" -> "STATE_START" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_ACTIVE_READ" -> "STATE_READ" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_ACTIVE_READ" -> "STATE_STOP" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S… |\n!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_START_WAIT" -> "STATE_ADDRESS_1" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_START" -> "STATE_ADDRESS_1" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_ADDRESS_1" -> "STATE_ADDRESS_2" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_ADDRESS_2" -> "STATE_READ" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_ADDRESS_2" -> "STATE_WRITE_1" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_WRITE_1" -> "STATE_WRITE_2" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_WRITE_2" -> "STATE_WRITE_3" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_WRITE_3" -> "STATE_WRITE_1" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_WRITE_3" -> "STATE_IDLE" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_WRITE_3" -> "STATE_ACTIVE_WRITE" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_READ" -> "STATE_STOP" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_READ" -> "STATE_ACTIVE_READ" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
  "STATE_STOP" -> "STATE_IDLE" [label="!(phy_state_reg != PHY_STATE_IDLE && phy_state_reg != PHY_S…"];
}