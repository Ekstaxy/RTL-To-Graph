digraph "mac_ctrl_rx.read_mcf_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="mac_ctrl_rx.read_mcf_reg (two-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "1" [label="reset"];
  "0" [label="0"];
  "1" [peripheries=2, label="1"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "0" [label="s_axis_tvalid && read_mcf_reg && ptr_reg == (HDR_SIZE-1)/BY…", style=dashed, color="#e76f51"];
  "__any" -> "1" [label="s_axis_tvalid && s_axis_tlast", style=dashed, color="#e76f51"];
}