digraph "float_multi.counter" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="float_multi.counter (one-process, 8 states)";
  __reset [shape=point, width=0.15];
  __reset -> "0" [label="reset"];
  "0" [peripheries=2, label="0"];
  "1" [label="1"];
  "2" [label="2"];
  "3" [label="3"];
  "4" [label="4"];
  "5" [label="5"];
  "6" [label="6"];
  "7" [label="7"];
  __outs [shape=note, fontsize=9, label="outputs: z(mealy)"];
}