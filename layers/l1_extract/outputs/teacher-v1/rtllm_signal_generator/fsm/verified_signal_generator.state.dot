digraph "verified_signal_generator.state" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="verified_signal_generator.state (one-process, 2 states)";
  __reset [shape=point, width=0.15];
  __reset -> "0" [label="reset"];
  "0" [peripheries=2, label="0"];
  "1" [label="1"];
  "0" -> "1" [label="wave == 5'b11111"];
  "1" -> "0" [label="wave == 5'b00000"];
  __outs [shape=note, fontsize=9, label="outputs: wave(moore)"];
}