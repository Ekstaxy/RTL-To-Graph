digraph "lm_core.ph" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="lm_core.ph (one-process, 1 states)";
  __reset [shape=point, width=0.15];
  __reset -> "PH_A" [label="reset"];
  "PH_A" [peripheries=2, label="PH_A"];
  __outs [shape=note, fontsize=9, label="outputs: act(moore)"];
}