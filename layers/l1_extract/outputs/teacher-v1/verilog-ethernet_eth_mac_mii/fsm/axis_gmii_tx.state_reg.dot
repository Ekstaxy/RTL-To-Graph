digraph "axis_gmii_tx.state_reg" {
  rankdir=LR; node [shape=ellipse, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  labelloc=t; label="axis_gmii_tx.state_reg (two-process, 7 states)";
  "STATE_IDLE" [label="STATE_IDLE"];
  "STATE_PREAMBLE" [label="STATE_PREAMBLE"];
  "STATE_PAYLOAD" [label="STATE_PAYLOAD"];
  "STATE_LAST" [label="STATE_LAST"];
  "STATE_PAD" [label="STATE_PAD"];
  "STATE_FCS" [label="STATE_FCS"];
  "STATE_IFG" [label="STATE_IFG"];
  "__any" [label="any state", shape=box, style="rounded,dashed", color="#e76f51", fontsize=9];
  "__any" -> "STATE_IDLE" [label="", style=dashed, color="#e76f51"];
  "STATE_IDLE" -> "STATE_PREAMBLE" [label="clk_enable && !(mii_select && mii_odd_reg) && s_axis_tvalid…"];
  "STATE_PREAMBLE" -> "STATE_PAYLOAD" [label="clk_enable && !(mii_select && mii_odd_reg) && !(frame_ptr_r…"];
  "STATE_PAYLOAD" -> "STATE_LAST" [label="clk_enable && !(mii_select && mii_odd_reg) && (!s_axis_tval…"];
  "STATE_LAST" -> "STATE_PAD" [label="clk_enable && !(mii_select && mii_odd_reg) && frame_min_cou…"];
  "STATE_LAST" -> "STATE_FCS" [label="clk_enable && !(mii_select && mii_odd_reg) && !frame_min_co…"];
  "STATE_PAD" -> "STATE_FCS" [label="clk_enable && !(mii_select && mii_odd_reg) && !frame_min_co…"];
  "STATE_FCS" -> "STATE_IFG" [label="clk_enable && !(mii_select && mii_odd_reg) && !(frame_ptr_r…"];
  "STATE_IFG" -> "STATE_IDLE" [label="clk_enable && !(mii_select && mii_odd_reg) && !(frame_ptr_r…"];
}