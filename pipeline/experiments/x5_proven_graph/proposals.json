 "serv_serv_state": [
  {
   "id": "serv_state.lifecycle",
   "observe": [
    "ibus_cyc",
    "o_cnt_en",
    "init_done"
   ],
   "source": "llm",
   "note": "SERV has no state register. Its instruction life cycle is spread over a fetch flag, the bit-counter enable and the two-stage flag; observing the three together gives the machine the official documentation draws."
  }
 ],
 "serv_serv_top": [
  {
   "id": "serv_state.lifecycle@state",
   "scope": [
    "state"
   ],
   "observe": [
    "ibus_cyc",
    "o_cnt_en",
    "init_done"
   ],
   "source": "llm",
   "note": "Same observation inside serv_top, with the parameters serv_top passes down."
  }
 ],
