    "how": "proposed: RES is the reset input"
   },
   "names": {
    "6": "`UART_STATE_IDLE",
    "7": "`UART_STATE_START",
    "8": "`UART_STATE_DATA0",
    "9": "`UART_STATE_DATA1",
