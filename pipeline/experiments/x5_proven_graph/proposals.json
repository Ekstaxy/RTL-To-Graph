    "12": "`UART_STATE_DATA4",
    "13": "`UART_STATE_DATA5",
    "14": "`UART_STATE_DATA6",
    "15": "`UART_STATE_DATA7",
    "0": "`UART_STATE_STOP",
    "1": "`UART_STATE_ACK"
   },
   "note": "Transmit state register. L1 finds nothing here: the next state is one nested conditional expression, not a case statement.",
   "options": {
    "sim_cycles": 40000,
    "sim_runs": 16,
    "stim": {
     "WR": 4,
     "RD": 4,
     "RXD": 6
    }
   }
  },
